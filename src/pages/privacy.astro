---
import Layout from '@/layouts/Layout.astro';
import PrivacySection from '@/features/shared/components/PrivacySection.astro';

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/privacy/`;
const description = "Read the Nutrition Solver privacy policy. Clear disclosures on browser local storage, cookies, and your GDPR and CCPA consumer privacy rights.";

const privacySchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "name": "Privacy Policy",
  "url": canonicalUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "Nutrition Solver",
    "url": `${siteOrigin}/`
  }
};
---

<Layout
  title="Privacy Policy"
  description={description}
  canonicalUrl={canonicalUrl}
  schema={privacySchema}
>
  <PrivacySection />
</Layout>
