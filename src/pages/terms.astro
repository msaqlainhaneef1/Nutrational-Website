---
import Layout from '@/layouts/Layout.astro';
import TermsSection from '@/features/shared/components/TermsSection.astro';

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/terms/`;
const description = "Read the Nutrition Solver terms of service, acceptable usage guidelines, medical disclaimers, and user agreement details for our website.";

const termsSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "name": "Terms of Service",
  "url": canonicalUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "Nutrition Solver",
    "url": `${siteOrigin}/`
  }
};
---

<Layout
  title="Terms of Service"
  description={description}
  canonicalUrl={canonicalUrl}
  schema={termsSchema}
>
  <TermsSection />
</Layout>
