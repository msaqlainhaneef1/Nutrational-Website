---
import Layout from '@/layouts/Layout.astro';
import CalculatorsDirectory from '@/features/calculators/shared/CalculatorsDirectory.astro';
const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/calculators/`;

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#collection`,
    "url": canonicalUrl,
    "name": "Health and Fitness Calculators",
    "description": "Free BMI, BMR, TDEE, macro, calorie deficit, ideal weight, body fat, water intake, and protein calculators. 100% private, browser-based tools.",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteOrigin}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Calculators",
          "item": canonicalUrl
        }
      ]
    }
  }
];
---

<Layout
  title="Free Health & Fitness Calculators"
  description="Free BMI, BMR, TDEE, macro, calorie deficit, ideal weight, body fat, water intake, and protein calculators. 100% private, browser-based tools."
  canonicalUrl={canonicalUrl}
  schema={schema}
>
  <CalculatorsDirectory />
</Layout>
