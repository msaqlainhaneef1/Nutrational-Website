---
import Layout from '@/layouts/Layout.astro';
import EditorialSection from '@/features/shared/components/EditorialSection.astro';

const title = "Editorial Policy & Medical Review Standards | Nutrition Solver";
const description = "Learn how Nutrition Solver fact-checks restaurant nutrition disclosures, verifies clinical formulas, and ensures commercial independence in all our nutrition guides.";
const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/editorial-policy/`;

const editorialSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Editorial Policy & Medical Review Standards",
  "url": canonicalUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "Nutrition Solver",
    "url": `${siteOrigin}/`
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "Dr. Sarah Jenkins, RDN, PhD",
    "jobTitle": "Lead Clinical Nutrition Reviewer",
    "url": `${siteOrigin}/authors/sarah-jenkins/`
  }
};
---

<Layout
  title="Editorial Policy & Fact-Checking"
  description={description}
  canonicalUrl={canonicalUrl}
  schema={editorialSchema}
>
  <EditorialSection />
</Layout>
