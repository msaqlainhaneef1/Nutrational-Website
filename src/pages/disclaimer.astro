---
import Layout from '@/layouts/Layout.astro';
import DisclaimerSection from '@/features/shared/components/DisclaimerSection.astro';

const title = "Medical & Health Disclaimer | Nutrition Solver";
const description = "Nutrition Solver provides educational nutrition and fitness reference data, not clinical medical advice. Always consult a qualified healthcare provider.";
const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/disclaimer/`;

const disclaimerSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Medical & Health Disclaimer",
  "url": canonicalUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "Nutrition Solver",
    "url": "https://nutritionsolver.com"
  }
};
---

<Layout
  title="Medical & Health Disclaimer"
  description={description}
  canonicalUrl={canonicalUrl}
  schema={disclaimerSchema}
>
  <DisclaimerSection />
</Layout>
