---
import Layout from '@/layouts/Layout.astro';
import AboutSection from '@/features/shared/components/AboutSection.astro';

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/about/`;
const description = "Nutrition Solver is an evidence-based nutrition reference covering 100+ restaurants and clinical health calculators. Learn about our mission and data sources.";

const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${canonicalUrl}#about`,
  "name": "About Nutrition Solver",
  "url": canonicalUrl,
  "description": description,
  "mainEntity": {
    "@type": "Organization",
    "name": "Nutrition Solver",
    "url": `${siteOrigin}/`,
    "foundingDate": "2024",
    "description": "Privacy-first nutrition reference covering 100 restaurant chains and 16,000+ menu items, plus clinically reviewed health calculators.",
    "knowsAbout": [
      "Nutrition Data",
      "Calorie Tracking",
      "Metabolic Health",
      "Dietary Reference Intakes"
    ]
  }
};
---

<Layout
  title="About Us & Mission"
  description={description}
  canonicalUrl={canonicalUrl}
  schema={aboutSchema}
>
  <AboutSection />
</Layout>
