---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import SearchContainer from '@/features/shared/components/SearchContainer.astro';
import { Search as SearchIcon } from '@lucide/astro';
const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/search/`;
---

<Layout
  title="Search Nutrition Database"
  description="Search across our complete food nutrition databases, restaurant chains, and health calculators. 100% private, instant client-side search."
  canonicalUrl={canonicalUrl}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumb items={[{ label: 'Search', url: '/search/' }]} />

    <div class="space-y-4">
      <div class="inline-flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <SearchIcon class="h-4 w-4" />
        <span>Static site search, runs in your browser</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Search the database
      </h1>
      <p class="text-zinc-400 text-base max-w-2xl leading-relaxed">
        Type a food, restaurant, calculator, or keyword below. The search runs entirely on your device in real-time
        against a build-time index of every page on the site. No tracking, no server round trips.
      </p>
    </div>

    <SearchContainer />
  </div>
</Layout>
