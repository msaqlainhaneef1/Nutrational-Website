---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import RestaurantPage from '@/features/restaurants/components/RestaurantPage.astro';
import { getAllRestaurants } from '@/features/restaurants/services/restaurant';
import { ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const restaurants = getAllRestaurants();
  return restaurants.map((restaurant) => ({
    params: { slug: restaurant.slug },
    props: { restaurant },
  }));
}

const { restaurant } = Astro.props;
const totalItems = restaurant.categories.reduce((s, c) => s + c.items.length, 0);

const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": restaurant.name,
  "description": restaurant.description || restaurant.tagline,
  "servesCuisine": restaurant.category,
  "hasMenu": {
    "@type": "Menu",
    "hasMenuSection": restaurant.categories.map((cat) => ({
      "@type": "MenuSection",
      "name": cat.name,
      "hasMenuItem": cat.items.map((item) => ({
        "@type": "MenuItem",
        "name": item.name,
        "nutrition": {
          "@type": "NutritionInformation",
          "calories": `${item.calories} kcal`,
          "proteinContent": `${item.protein} g`,
          "fatContent": `${item.fat} g`,
          "carbohydrateContent": `${item.carbs} g`,
          ...(item.fiber != null ? { "fiberContent": `${item.fiber} g` } : {}),
          ...(item.sodium != null ? { "sodiumContent": `${item.sodium} mg` } : {}),
          ...(item.sugars != null ? { "sugarContent": `${item.sugars} g` } : {}),
        }
      }))
    }))
  }
};
---

<Layout
  title={`${restaurant.name} Nutrition and Calories`}
  description={`Browse ${totalItems} menu items from ${restaurant.name} with full calorie, protein, carb, fat, fiber, sodium, and sugar data. Filter by category and search by name.`}
  schema={schema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex items-center justify-between">
      <Breadcrumb items={[
        { label: 'Restaurants', url: '/restaurants' },
        { label: restaurant.name }
      ]} />
      <a href="/restaurants" class="inline-flex items-center text-xs text-zinc-400 hover:text-emerald-400 font-semibold transition-colors">
        <ArrowLeft class="h-3.5 w-3.5 mr-1" />
        Back to restaurants
      </a>
    </div>

    <!-- Header -->
    <div class="border-b border-zinc-900 pb-6 space-y-3">
      <div class="flex items-center gap-3">
        <span class="text-5xl">{restaurant.emoji || '🍽'}</span>
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{restaurant.name}</h1>
          <div class="flex items-center gap-2 mt-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full">
              {restaurant.category || 'Restaurant'}
            </span>
            <span class="text-xs text-zinc-500">{totalItems} menu items</span>
          </div>
        </div>
      </div>
      {restaurant.description && (
        <p class="text-zinc-400 text-sm max-w-3xl leading-relaxed pt-2">{restaurant.description}</p>
      )}
    </div>

    <RestaurantPage restaurant={restaurant} />
  </div>
</Layout>
