---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import RestaurantPage from '@/features/restaurants/components/RestaurantPage.astro';
import { getAllRestaurants, getFullRestaurantBySlug } from '@/features/restaurants/services/restaurant';
import { ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const restaurants = getAllRestaurants();
  return restaurants.map((r) => {
    const restaurant = getFullRestaurantBySlug(r.slug)!;
    return {
      params: { slug: r.slug },
      props: { restaurant },
    };
  });
}

const { restaurant: propsRestaurant } = Astro.props;
const { slug } = Astro.params;
const restaurant = propsRestaurant || (slug ? getFullRestaurantBySlug(slug) : undefined);

if (!restaurant) {
  return Astro.redirect('/404');
}

const totalItems = restaurant.categories.reduce((s, c) => s + c.items.length, 0);

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}/restaurants/${restaurant.slug}/`;

const schema = [
  {
    "@type": "ItemPage",
    "@id": `${canonicalUrl}#itempage`,
    "url": canonicalUrl,
    "name": `${restaurant.name} Nutrition Calculator & Calories`,
    "description": `Comprehensive nutrition guide and calorie calculator for ${restaurant.name}. Covers ${totalItems} menu items with protein, carbs, fat, and sodium data.`,
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteOrigin}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Restaurants",
          "item": `${siteOrigin}/restaurants/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": restaurant.name,
          "item": canonicalUrl
        }
      ]
    },
    "mainEntity": {
      "@type": "Dataset",
      "name": `${restaurant.name} Nutrition Dataset`,
      "description": `Full nutritional breakdown for ${restaurant.name} menu items including calories, macronutrients, and micronutrients.`,
      "variableMeasured": ["Calories", "Protein", "Total Fat", "Carbohydrates", "Dietary Fiber", "Sodium", "Sugars"],
      "creator": {
        "@type": "Organization",
        "name": "Nutrition Solver"
      }
    }
  },
  ...(restaurant.faqs && restaurant.faqs.length > 0 ? [{
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "mainEntity": restaurant.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }] : [])
];

const pageTitle = `${restaurant.name} Nutrition Calculator & Calories`;
const pageDescription = `Complete ${restaurant.name} nutrition calculator. View calories, protein, carbs, and fat for ${totalItems} menu items. Plan your meal macros for free.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={schema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="flex items-center justify-between">
      <Breadcrumb items={[
        { label: 'Restaurants', url: '/restaurants/' },
        { label: restaurant.name }
      ]} />
      <a href="/restaurants/" class="inline-flex items-center text-xs text-zinc-400 hover:text-emerald-400 font-semibold transition-colors">
        <ArrowLeft class="h-3.5 w-3.5 mr-1" />
        Back to restaurants
      </a>
    </div>

    <!-- Header -->
    <div class="border-b border-zinc-900 pb-8 space-y-4">
      <div class="flex items-start gap-4">
        <span class="text-6xl leading-none">{restaurant.emoji || '🍽'}</span>
        <div class="flex-grow">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
              {restaurant.category || 'Restaurant'}
            </span>
            <span class="text-xs text-zinc-500">{totalItems} menu items indexed</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">{restaurant.name}</h1>
          {restaurant.description && (
            <p class="text-zinc-400 text-sm md:text-base max-w-3xl leading-relaxed pt-3">{restaurant.description}</p>
          )}
        </div>
      </div>
    </div>

    <RestaurantPage restaurant={restaurant} />
  </div>
</Layout>
