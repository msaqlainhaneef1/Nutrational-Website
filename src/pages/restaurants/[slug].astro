---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import RestaurantPage from '@/features/restaurants/components/RestaurantPage.astro';
import { getAllRestaurants, getFullRestaurantBySlug } from '@/features/restaurants/services/restaurant';
import { ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const restaurants = getAllRestaurants();
  return restaurants.map((r) => {
    const restaurant = getFullRestaurantBySlug(r.slug)!;
    return {
      params: { slug: r.slug },
      props: { restaurant },
    };
  });
}

const { restaurant: propsRestaurant } = Astro.props;
const { slug } = Astro.params;
const restaurant = propsRestaurant || (slug ? getFullRestaurantBySlug(slug) : undefined);

if (!restaurant) {
  return Astro.redirect('/404');
}

const totalItems = restaurant.categories.reduce((s, c) => s + c.items.length, 0);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": restaurant.name,
    "description": restaurant.seoDescription || restaurant.description || restaurant.tagline,
    "servesCuisine": restaurant.category,
    "hasMenu": {
      "@type": "Menu",
      "hasMenuSection": restaurant.categories.map((cat) => ({
        "@type": "MenuSection",
        "name": cat.name,
        "hasMenuItem": cat.items.map((item) => ({
          "@type": "MenuItem",
          "name": item.name,
          "nutrition": {
            "@type": "NutritionInformation",
            "calories": `${item.calories} kcal`,
            "proteinContent": `${item.protein} g`,
            "fatContent": `${item.fat} g`,
            "carbohydrateContent": `${item.carbs} g`,
            ...(item.fiber != null ? { "fiberContent": `${item.fiber} g` } : {}),
            ...(item.sodium != null ? { "sodiumContent": `${item.sodium} mg` } : {}),
            ...(item.sugars != null ? { "sugarContent": `${item.sugars} g` } : {}),
          }
        }))
      }))
    }
  },
  ...(restaurant.faqs && restaurant.faqs.length > 0 ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": restaurant.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }] : [])
];
---

<Layout
  title={restaurant.seoTitle || `${restaurant.name} Nutrition Calculator: Calories, Protein & Macros`}
  description={restaurant.seoDescription || `Browse ${totalItems} menu items from ${restaurant.name} with full calorie, protein, carb, fat, fiber, sodium, and sugar data.`}
  schema={schema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="flex items-center justify-between">
      <Breadcrumb items={[
        { label: 'Restaurants', url: '/restaurants' },
        { label: restaurant.name }
      ]} />
      <a href="/restaurants" class="inline-flex items-center text-xs text-zinc-400 hover:text-emerald-400 font-semibold transition-colors">
        <ArrowLeft class="h-3.5 w-3.5 mr-1" />
        Back to restaurants
      </a>
    </div>

    <!-- Header -->
    <div class="border-b border-zinc-900 pb-8 space-y-4">
      <div class="flex items-start gap-4">
        <span class="text-6xl leading-none">{restaurant.emoji || '🍽'}</span>
        <div class="flex-grow">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
              {restaurant.category || 'Restaurant'}
            </span>
            <span class="text-xs text-zinc-500">{totalItems} menu items indexed</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">{restaurant.name}</h1>
          {restaurant.description && (
            <p class="text-zinc-400 text-sm md:text-base max-w-3xl leading-relaxed pt-3">{restaurant.description}</p>
          )}
        </div>
      </div>
    </div>

    <RestaurantPage restaurant={restaurant} />
  </div>
</Layout>
