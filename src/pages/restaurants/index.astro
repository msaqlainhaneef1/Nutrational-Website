---
import Layout from '@/layouts/Layout.astro';
import RestaurantsDirectory from '@/features/restaurants/components/RestaurantsDirectory.astro';
import { getAllRestaurants, getAllCategories } from '@/features/restaurants/services/restaurant';

const restaurants = getAllRestaurants();
const categories = getAllCategories();
---

<Layout
  title="Restaurant Nutrition Database"
  description="Browse nutrition data for 100+ restaurant chains and 16,000+ menu items. Search by name, filter by cuisine, see calories and macros for every dish."
>
  <RestaurantsDirectory restaurants={restaurants} categories={categories} />
</Layout>
