---
import Layout from '@/layouts/Layout.astro';
import HomeHero from '@/features/shared/components/HomeHero.astro';
import HomeStats from '@/features/shared/components/HomeStats.astro';
import HomeRestaurants from '@/features/shared/components/HomeRestaurants.astro';
import HomeCalculators from '@/features/shared/components/HomeCalculators.astro';
import HomeFoods from '@/features/shared/components/HomeFoods.astro';
import HomeHowItWorks from '@/features/shared/components/HomeHowItWorks.astro';
import HomePrivacy from '@/features/shared/components/HomePrivacy.astro';
import { getAllFoods } from '@/features/nutrition/services/food';
import { getFeaturedRestaurants, getRestaurantStats } from '@/features/restaurants/services/restaurant';

const stats = getRestaurantStats();
const featuredFoods = getAllFoods().slice(0, 4);
const featuredRestaurants = getFeaturedRestaurants(8);
---

<Layout
  title="Nutrition data for 100+ restaurants and free health calculators"
  description="Browse calorie and macro data for 100 restaurant chains and 16,000+ menu items. Free BMI, BMR, TDEE, macro, and calorie deficit calculators. No tracking, no signup, no fluff."
>
  <HomeHero stats={stats} />
  <HomeStats stats={stats} />
  <HomeRestaurants restaurants={featuredRestaurants} categories={stats.categories} />
  <HomeCalculators />
  <HomeFoods featuredFoods={featuredFoods} />
  <HomeHowItWorks />
  <HomePrivacy />
</Layout>
