---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { ArrowUp, ShieldCheck } from '@lucide/astro';
import { CALCULATORS, CALCULATOR_CATEGORIES, getPopularCalculators } from '@/features/calculators/shared/registry';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  authorName?: string;
  schema?: object | object[];
}

const {
  title,
  description = "Browse nutrition data for 100+ restaurants and 16,000+ menu items. Free BMI, BMR, TDEE, macro, calorie deficit, ideal weight, body fat, water intake, and protein calculators. No tracking, no signup.",
  canonicalUrl = Astro.url.href,
  image = "/favicon.svg",
  type = "website",
  publishedTime,
  authorName,
  schema,
} = Astro.props;

const siteName = "Nutrition Solver";

const baseUrl = (Astro.site ? Astro.site.toString() : 'https://nutritionsolver.com').replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '');
const resolvedCanonical = canonicalUrl || (pathname ? `${baseUrl}${pathname}/` : `${baseUrl}/`);

// Form formatted title to ensure length stays within 50-60 characters and prevent double branding
let formattedTitle = title.trim();
if (!formattedTitle.toLowerCase().includes('nutrition solver')) {
  formattedTitle = `${formattedTitle} | ${siteName}`;
}

const currentPath = Astro.url.pathname;
const popularCalcs = getPopularCalculators(4);

const baseGraph: any[] = [
  {
    "@type": "Organization",
    "@id": `${baseUrl}/#organization`,
    "name": siteName,
    "url": `${baseUrl}/`,
    "logo": `${baseUrl}/favicon.svg`,
    "description": "Privacy-first nutrition reference covering 100+ restaurant chains and 16,000+ menu items, plus free health calculators."
  },
  {
    "@type": "WebSite",
    "@id": `${baseUrl}/#website`,
    "name": siteName,
    "url": `${baseUrl}/`,
    "publisher": { "@id": `${baseUrl}/#organization` },
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${baseUrl}/search?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@type": type === 'article' ? 'BlogPosting' : 'WebPage',
    "@id": `${resolvedCanonical}#webpage`,
    "url": resolvedCanonical,
    "name": formattedTitle,
    "headline": title,
    "description": description,
    "isPartOf": { "@id": `${baseUrl}/#website` },
    ...(type === 'article' && publishedTime ? {
      "datePublished": publishedTime,
      "author": { "@type": "Person", "name": authorName || "Nutrition Solver Editorial" }
    } : {})
  }
];

if (schema) {
  const customSchemas = Array.isArray(schema) ? schema : [schema];
  for (const s of customSchemas) {
    if (s && typeof s === 'object') {
      const { ['@context']: _, ...rest } = s as Record<string, any>;
      baseGraph.push(rest);
    }
  }
}

const finalLdJson = {
  "@context": "https://schema.org",
  "@graph": baseGraph
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Core Web Vitals Font Optimization -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    <meta name="theme-color" content="#09090b" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {authorName && <meta property="article:author" content={authorName} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(finalLdJson)} />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased flex flex-col mesh-bg">
    <!-- Scroll progress bar -->
    <div id="scroll-progress" class="fixed top-0 left-0 w-0 h-0.5 bg-gradient-to-r from-emerald-500 to-teal-400 z-[60] transition-[width] duration-100"></div>

    <!-- Announcement bar -->
    <!-- Common Centralized Header Component -->
    <Header currentPath={currentPath} />

    <main class="flex-grow" data-pagefind-body>
      <slot />
    </main>

    <!-- Common Centralized Footer Component -->
    <Footer siteName={siteName} />

    <!-- Back to top button -->
    <button id="back-to-top" type="button" class="hidden fixed bottom-6 right-6 z-50 p-3 bg-zinc-900 border border-zinc-700 hover:border-emerald-500/50 hover:bg-emerald-500/10 text-zinc-300 hover:text-emerald-400 rounded-full shadow-lg transition-all" aria-label="Back to top">
      <ArrowUp class="h-5 w-5" />
    </button>

    <!-- Cookie consent banner -->
    <div id="cookie-banner" class="hidden fixed bottom-0 left-0 right-0 z-50 glass-panel border-t border-zinc-800 p-4 md:p-5">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-center md:text-left">
          <div class="hidden md:flex p-2 bg-emerald-500/10 text-emerald-400 rounded-lg border border-emerald-500/20">
            <ShieldCheck class="h-5 w-5" />
          </div>
          <div>
            <p class="text-sm text-zinc-300 font-medium">We use zero tracking cookies.</p>
            <p class="text-xs text-zinc-500 mt-0.5">All calculator inputs stay in your browser. <a href="/privacy/" class="text-emerald-400 underline">Read the privacy policy</a>.</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button id="cookie-ack" type="button" class="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-xs rounded-lg transition-colors">Got it</button>
        </div>
      </div>
    </div>

    <!-- All scripts -->
    <script is:inline>
      // Mobile menu
      (function() {
        const menuBtn = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        const openIcon = document.getElementById('menu-icon-open');
        const closeIcon = document.getElementById('menu-icon-close');
        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', () => {
            const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
            menuBtn.setAttribute('aria-expanded', String(!expanded));
            mobileMenu.classList.toggle('hidden');
            openIcon?.classList.toggle('hidden');
            closeIcon?.classList.toggle('hidden');
          });
        }
      })();

      // Mega menu (click to open, click outside to close)
      (function() {
        const trigger = document.getElementById('mega-menu-trigger');
        const menu = document.getElementById('mega-menu');
        if (trigger && menu) {
          trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const expanded = trigger.getAttribute('aria-expanded') === 'true';
            trigger.setAttribute('aria-expanded', String(!expanded));
            menu.classList.toggle('hidden');
          });
          document.addEventListener('click', (e) => {
            if (!menu.contains(e.target) && !trigger.contains(e.target)) {
              menu.classList.add('hidden');
              trigger.setAttribute('aria-expanded', 'false');
            }
          });
        }
      })();

      // Scroll progress bar
      (function() {
        const bar = document.getElementById('scroll-progress');
        if (!bar) return;
        const update = () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          bar.style.width = pct + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();

      // Back to top button
      (function() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', () => {
          if (window.scrollY > 600) {
            btn.classList.remove('hidden');
          } else {
            btn.classList.add('hidden');
          }
        }, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();

      // Announcement bar dismiss
      (function() {
        const closeBtn = document.getElementById('announcement-close');
        const bar = document.getElementById('announcement-bar');
        if (closeBtn && bar) {
          if (sessionStorage.getItem('ns-announcement-dismissed') === '1') {
            bar.style.display = 'none';
          }
          closeBtn.addEventListener('click', () => {
            bar.style.display = 'none';
            sessionStorage.setItem('ns-announcement-dismissed', '1');
          });
        }
      })();

      // Cookie consent
      (function() {
        const banner = document.getElementById('cookie-banner');
        const ack = document.getElementById('cookie-ack');
        if (!banner || !ack) return;
        if (localStorage.getItem('ns-cookie-ack') === '1') return;
        setTimeout(() => { banner.classList.remove('hidden'); }, 2500);
        ack.addEventListener('click', () => {
          localStorage.setItem('ns-cookie-ack', '1');
          banner.classList.add('hidden');
        });
      })();
    </script>
  </body>
</html>
