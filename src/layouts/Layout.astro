---
import '../styles/global.css';
import { Leaf, Search, Menu, X } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  authorName?: string;
  schema?: object | object[];
}

const {
  title,
  description = "Get comprehensive food nutrition data, calculator tools, and healthy eating guides for a healthier lifestyle.",
  canonicalUrl = Astro.url.href,
  image = "/images/og-default.jpg",
  type = "website",
  publishedTime,
  authorName,
  schema,
} = Astro.props;

const siteName = "NutriFlow";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | {siteName}</title>
    <meta name="title" content={`${title} | ${siteName}`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {authorName && <meta property="article:author" content={authorName} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | ${siteName}`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === 'article' ? 'BlogPosting' : 'WebSite',
      "name": siteName,
      "url": Astro.site || Astro.url.origin,
      "headline": title,
      "description": description,
      ...(type === 'article' ? {
        "datePublished": publishedTime,
        "author": {
          "@type": "Person",
          "name": authorName || "NutriFlow Editorial"
        }
      } : {})
    })}/>

    <!-- Page-Specific Structured Data -->
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-50 glass-panel border-b border-zinc-800/60 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="flex items-center space-x-2 text-emerald-500 hover:text-emerald-400 transition-colors" id="nav-logo">
              <Leaf class="h-6 w-6" />
              <span class="font-extrabold text-xl tracking-tight text-white">{siteName}</span>
            </a>
          </div>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center space-x-8">
            <a href="/foods" class="text-zinc-300 hover:text-emerald-400 font-medium text-sm transition-colors" id="nav-foods">Foods</a>
            <a href="/restaurants" class="text-zinc-300 hover:text-emerald-400 font-medium text-sm transition-colors" id="nav-restaurants">Restaurants</a>
            <a href="/calculators" class="text-zinc-300 hover:text-emerald-400 font-medium text-sm transition-colors" id="nav-calculators">Calculators</a>
            <a href="/blog" class="text-zinc-300 hover:text-emerald-400 font-medium text-sm transition-colors" id="nav-blog">Blog</a>
          </nav>

          <!-- Action Elements -->
          <div class="flex items-center space-x-4">
            <a href="/search" class="p-2 text-zinc-400 hover:text-emerald-400 hover:bg-zinc-900/60 rounded-full transition-all duration-200" aria-label="Search" id="nav-search">
              <Search class="h-5 w-5" />
            </a>

            <!-- Mobile menu button -->
            <button 
              type="button" 
              class="md:hidden p-2 text-zinc-400 hover:text-white focus:outline-none" 
              aria-controls="mobile-menu" 
              aria-expanded="false"
              id="mobile-menu-button"
            >
              <Menu class="h-6 w-6 block" id="menu-icon-open" />
              <X class="h-6 w-6 hidden" id="menu-icon-close" />
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div class="hidden md:hidden border-t border-zinc-800/80 bg-zinc-950/95" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
          <a href="/foods" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-emerald-400 hover:bg-zinc-900">Foods</a>
          <a href="/restaurants" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-emerald-400 hover:bg-zinc-900">Restaurants</a>
          <a href="/calculators" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-emerald-400 hover:bg-zinc-900">Calculators</a>
          <a href="/blog" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-300 hover:text-emerald-400 hover:bg-zinc-900">Blog</a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow" data-pagefind-body>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-zinc-950 border-t border-zinc-900 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="space-y-4">
            <div class="flex items-center space-x-2 text-emerald-500">
              <Leaf class="h-6 w-6" />
              <span class="font-extrabold text-xl tracking-tight text-white">{siteName}</span>
            </div>
            <p class="text-zinc-400 text-sm">
              Providing evidence-based nutritional resources, tools, and calculators for health conscious lifestyle choices.
            </p>
          </div>
          <div>
            <h3 class="text-zinc-200 font-semibold text-sm uppercase tracking-wider mb-4">Resources</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li><a href="/foods" class="hover:text-emerald-400 transition-colors">Foods Directory</a></li>
              <li><a href="/restaurants" class="hover:text-emerald-400 transition-colors">Restaurants Nutrition</a></li>
              <li><a href="/calculators" class="hover:text-emerald-400 transition-colors">Health Calculators</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-zinc-200 font-semibold text-sm uppercase tracking-wider mb-4">Company</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li><a href="/blog" class="hover:text-emerald-400 transition-colors">Blog Articles</a></li>
              <li><a href="/about" class="hover:text-emerald-400 transition-colors">About Us</a></li>
              <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Contact</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-zinc-200 font-semibold text-sm uppercase tracking-wider mb-4">Compliance</h3>
            <ul class="space-y-2 text-sm text-zinc-400">
              <li><a href="/privacy" class="hover:text-emerald-400 transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-emerald-400 transition-colors">Terms of Service</a></li>
              <li><a href="/disclaimer" class="hover:text-emerald-400 transition-colors">Medical Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-zinc-900 flex flex-col md:flex-row items-center justify-between">
          <p class="text-zinc-500 text-xs">&copy; {new Date().getFullYear()} {siteName}. All rights reserved.</p>
          <div class="flex space-x-6 mt-4 md:mt-0">
            <a href="https://github.com" class="text-zinc-500 hover:text-zinc-300 transition-colors" aria-label="GitHub">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Toggle Script -->
    <script is:inline>
      const menuBtn = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
          menuBtn.setAttribute('aria-expanded', !isExpanded);
          mobileMenu.classList.toggle('hidden');
          openIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
