---
import { Flame } from '@lucide/astro';

interface MacroVal {
  value: number;
  unit: string;
}

interface Props {
  name: string;
  slug: string;
  category: string;
  calories: number;
  protein: MacroVal;
  fat: MacroVal;
  carbs: MacroVal;
}

const { name, slug, category, calories, protein, fat, carbs } = Astro.props;
---

<a href={`/foods/${slug}`} class="glass-card rounded-3xl p-6 block flex flex-col justify-between h-full group relative overflow-hidden border border-zinc-900/60 hover:border-emerald-500/20">
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/0 via-emerald-500/0 to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

  <div class="relative z-10 space-y-5">
    <div class="flex items-center justify-between">
      <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-xl bg-zinc-900/80 border border-zinc-800/60 text-zinc-400 font-sans">
        {category}
      </span>
      <span class="flex items-center text-xs text-amber-400 font-bold bg-amber-500/10 px-2.5 py-1 rounded-xl border border-amber-500/20 font-sans">
        <Flame class="h-3.5 w-3.5 mr-1 fill-amber-400/20" />
        {calories} kcal
      </span>
    </div>

    <div>
      <h3 class="font-extrabold text-lg text-white group-hover:text-emerald-400 transition-colors leading-tight font-display">
        {name}
      </h3>
      <p class="text-xs text-zinc-550 mt-1 font-sans">Per 100g serving</p>
    </div>

    <div class="grid grid-cols-3 gap-2.5 pt-1 text-center">
      <div class="bg-zinc-950/40 border border-zinc-900/60 rounded-xl p-2.5">
        <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-550 font-sans">Protein</div>
        <div class="text-sm font-extrabold text-emerald-400 mt-0.5 font-sans">{protein.value}{protein.unit}</div>
      </div>
      <div class="bg-zinc-950/40 border border-zinc-900/60 rounded-xl p-2.5">
        <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-550 font-sans">Carbs</div>
        <div class="text-sm font-extrabold text-blue-400 mt-0.5 font-sans">{carbs.value}{carbs.unit}</div>
      </div>
      <div class="bg-zinc-950/40 border border-zinc-900/60 rounded-xl p-2.5">
        <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-550 font-sans">Fat</div>
        <div class="text-sm font-extrabold text-amber-400 mt-0.5 font-sans">{fat.value}{fat.unit}</div>
      </div>
    </div>
  </div>

  <div class="relative z-10 mt-6 pt-4 border-t border-zinc-900/60 flex items-center justify-between text-xs text-emerald-400 font-bold uppercase tracking-wider font-sans">
    <span>View Details</span>
    <svg class="h-4 w-4 transform group-hover:translate-x-1.5 transition-transform stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </div>
</a>
