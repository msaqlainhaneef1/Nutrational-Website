---
import { Flame } from '@lucide/astro';

interface MacroVal {
  value: number;
  unit: string;
}

interface Props {
  name: string;
  slug: string;
  category: string;
  calories: number;
  protein: MacroVal;
  fat: MacroVal;
  carbs: MacroVal;
}

const { name, slug, category, calories, protein, fat, carbs } = Astro.props;
---

<a href={`/foods/${slug}`} class="glass-card rounded-2xl p-5 flex flex-col justify-between h-full group relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/0 via-emerald-500/0 to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

  <div class="relative z-10 space-y-4">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400">
        {category}
      </span>
      <span class="flex items-center text-xs text-amber-500 font-bold bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">
        <Flame class="h-3 w-3 mr-1 fill-amber-500" />
        {calories} kcal
      </span>
    </div>

    <div>
      <h3 class="font-bold text-lg text-white group-hover:text-emerald-400 transition-colors leading-tight">
        {name}
      </h3>
      <p class="text-xs text-zinc-500 mt-1">Per 100g serving</p>
    </div>

    <div class="grid grid-cols-3 gap-2 pt-2 text-center">
      <div class="bg-zinc-900/80 border border-zinc-800/60 rounded-xl p-2">
        <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">Protein</div>
        <div class="text-sm font-extrabold text-emerald-400 mt-0.5">{protein.value}{protein.unit}</div>
      </div>
      <div class="bg-zinc-900/80 border border-zinc-800/60 rounded-xl p-2">
        <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">Carbs</div>
        <div class="text-sm font-extrabold text-blue-400 mt-0.5">{carbs.value}{carbs.unit}</div>
      </div>
      <div class="bg-zinc-900/80 border border-zinc-800/60 rounded-xl p-2">
        <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">Fat</div>
        <div class="text-sm font-extrabold text-amber-400 mt-0.5">{fat.value}{fat.unit}</div>
      </div>
    </div>
  </div>

  <div class="relative z-10 mt-5 pt-3 border-t border-zinc-900/80 flex items-center justify-between text-xs text-emerald-400 font-semibold">
    <span>View detailed report</span>
    <span class="transform group-hover:translate-x-1 transition-transform duration-300">&rarr;</span>
  </div>
</a>
