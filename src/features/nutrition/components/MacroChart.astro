---
interface Props {
  protein: number;
  carbs: number;
  fat: number;
}

const { protein, carbs, fat } = Astro.props;
---

<div class="glass-card rounded-2xl p-6 flex flex-col items-center justify-center border border-zinc-800">
  <h4 class="font-bold text-base text-zinc-200 mb-4 uppercase tracking-wider text-center">Macronutrient Distribution</h4>
  
  <div class="relative w-52 h-52">
    <div class="absolute inset-0 flex items-center justify-center text-xs text-zinc-500 chart-loader">
      <span>Loading chart...</span>
    </div>
    
    <canvas 
      class="macro-doughnut-chart w-full h-full opacity-0 transition-opacity duration-500" 
      data-protein={protein} 
      data-carbs={carbs} 
      data-fat={fat}
    ></canvas>
  </div>

  <div class="flex justify-center space-x-6 mt-6 text-xs font-semibold">
    <div class="flex items-center space-x-1.5">
      <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
      <span class="text-zinc-300">Protein ({protein}g)</span>
    </div>
    <div class="flex items-center space-x-1.5">
      <span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>
      <span class="text-zinc-300">Carbs ({carbs}g)</span>
    </div>
    <div class="flex items-center space-x-1.5">
      <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
      <span class="text-zinc-300">Fat ({fat}g)</span>
    </div>
  </div>
</div>

<script>
  const charts = document.querySelectorAll('.macro-doughnut-chart');

  const observer = new IntersectionObserver((entries, self) => {
    entries.forEach(async (entry) => {
      if (entry.isIntersecting) {
        self.unobserve(entry.target);
        
        const canvas = entry.target as HTMLCanvasElement;
        const loader = canvas.parentElement?.querySelector('.chart-loader');
        
        const protein = parseFloat(canvas.dataset.protein || '0');
        const carbs = parseFloat(canvas.dataset.carbs || '0');
        const fat = parseFloat(canvas.dataset.fat || '0');
        
        if (protein === 0 && carbs === 0 && fat === 0) {
          if (loader) loader.textContent = 'No macro data available';
          return;
        }

        try {
          // @ts-ignore
          const { Chart } = await import('chart.js/auto');

          new Chart(canvas, {
            type: 'doughnut',
            data: {
              labels: ['Protein', 'Carbs', 'Fat'],
              datasets: [{
                data: [protein, carbs, fat],
                backgroundColor: ['#10b981', '#3b82f6', '#f59e0b'],
                borderColor: '#18181b',
                borderWidth: 2,
                hoverOffset: 4
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    label: function(context: any) {
                      const value = context.raw || 0;
                      const total = protein + carbs + fat;
                      const percentage = Math.round((value / total) * 100);
                      return ` ${context.label}: ${value}g (${percentage}%)`;
                    }
                  }
                }
              },
              cutout: '70%'
            }
          });

          canvas.classList.remove('opacity-0');
          if (loader) loader.remove();
        } catch (err) {
          console.error('Failed to load Chart.js:', err);
          if (loader) loader.textContent = 'Failed to load chart';
        }
      }
    });
  }, { rootMargin: '100px' });

  charts.forEach((chart) => observer.observe(chart));
</script>
