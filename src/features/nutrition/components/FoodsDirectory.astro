---
import FoodCard from './FoodCard.astro';
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import { Database } from '@lucide/astro';
import type { Food } from '../schemas/food';

interface Props {
  foods: Food[];
}

const { foods } = Astro.props;

// Group foods by category
const byCategory = new Map<string, Food[]>();
for (const food of foods) {
  const cat = food.category || 'Other';
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(food);
}
const sortedCategories = [...byCategory.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <Breadcrumb items={[{ label: 'Foods', url: '/foods/' }]} />

  <!-- Header -->
  <div class="space-y-3">
    <div class="inline-flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
      <Database class="h-4 w-4" />
      <span>{foods.length} foods indexed</span>
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">
      Whole food nutrition facts
    </h1>
    <p class="text-zinc-400 text-base max-w-3xl leading-relaxed">
      Plain reference data for single-ingredient foods. No branded products, no marketing copy.
      Calories, macros, and key micronutrients per 100 gram serving. Click any food for the full
      nutrition label, macro chart, and FAQ.
    </p>
  </div>

  <!-- Foods grid grouped by category -->
  {sortedCategories.map(([category, items]) => (
    <section class="space-y-4">
      <div class="flex items-baseline justify-between border-b border-zinc-900 pb-2">
        <h2 class="text-xl font-bold text-white">{category}</h2>
        <span class="text-xs text-zinc-500 font-semibold">{items.length} foods</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {items.map((food) => (
          <FoodCard
            name={food.name}
            slug={food.slug}
            category={food.category}
            calories={food.calories}
            protein={food.macros.protein}
            fat={food.macros.fat}
            carbs={food.macros.carbs}
          />
        ))}
      </div>
    </section>
  ))}
</div>
