---
interface Nutrient {
  value: number;
  unit: string;
  pctDailyValue?: number;
}

interface Props {
  name: string;
  servingSize: string;
  calories: number;
  macros: {
    protein: Nutrient;
    fat: Nutrient;
    carbs: Nutrient;
    fiber?: Nutrient;
    sugar?: Nutrient;
  };
  micros?: {
    sodium?: Nutrient;
    potassium?: Nutrient;
    cholesterol?: Nutrient;
    vitaminA?: Nutrient;
    vitaminC?: Nutrient;
    calcium?: Nutrient;
    iron?: Nutrient;
  };
}

const { name, servingSize, calories, macros, micros = {} } = Astro.props;
---

<div class="glass-card rounded-2xl p-6 max-w-md mx-auto border-t-4 border-t-emerald-500">
  <div class="border-b border-zinc-800 pb-3">
    <h3 class="font-extrabold text-2xl tracking-tight text-white uppercase">Nutrition Facts</h3>
    <p class="text-sm text-zinc-400 mt-1">Food name: <span class="text-white font-semibold">{name}</span></p>
    <p class="text-sm text-zinc-400">Serving Size: <span class="text-white font-semibold">{servingSize}</span></p>
  </div>

  <div class="flex justify-between items-baseline py-4 border-b-8 border-zinc-800">
    <span class="font-black text-xl text-white">Amount Per Serving</span>
    <div class="text-right">
      <span class="font-bold text-sm text-zinc-400 block uppercase">Calories</span>
      <span class="font-black text-4xl text-emerald-400">{calories}</span>
    </div>
  </div>

  <div class="text-right text-xs font-bold text-zinc-400 py-1.5 border-b border-zinc-800">
    % Daily Value *
  </div>

  <div class="divide-y divide-zinc-900 border-b-4 border-zinc-800">
    <div class="flex justify-between py-2.5 text-sm">
      <span class="text-white"><strong class="font-bold">Total Fat</strong> {macros.fat.value}{macros.fat.unit}</span>
      <span class="font-bold text-white">{macros.fat.pctDailyValue !== undefined ? `${macros.fat.pctDailyValue}%` : '--'}</span>
    </div>

    <div class="flex justify-between py-2.5 text-sm">
      <span class="text-white"><strong class="font-bold">Total Carbohydrate</strong> {macros.carbs.value}{macros.carbs.unit}</span>
      <span class="font-bold text-white">{macros.carbs.pctDailyValue !== undefined ? `${macros.carbs.pctDailyValue}%` : '--'}</span>
    </div>

    {macros.fiber && (
      <div class="flex justify-between py-2.5 pl-4 text-sm">
        <span class="text-zinc-300">Dietary Fiber {macros.fiber.value}{macros.fiber.unit}</span>
        <span class="font-bold text-zinc-300">{macros.fiber.pctDailyValue !== undefined ? `${macros.fiber.pctDailyValue}%` : '--'}</span>
      </div>
    )}

    {macros.sugar && (
      <div class="flex justify-between py-2.5 pl-4 text-sm">
        <span class="text-zinc-300">Total Sugars {macros.sugar.value}{macros.sugar.unit}</span>
        <span class="font-bold text-zinc-300">{macros.sugar.pctDailyValue !== undefined ? `${macros.sugar.pctDailyValue}%` : '--'}</span>
      </div>
    )}

    <div class="flex justify-between py-2.5 text-sm">
      <span class="text-white"><strong class="font-bold">Protein</strong> {macros.protein.value}{macros.protein.unit}</span>
      <span class="font-bold text-white">{macros.protein.pctDailyValue !== undefined ? `${macros.protein.pctDailyValue}%` : '--'}</span>
    </div>
  </div>

  {Object.keys(micros).length > 0 && (
    <div class="divide-y divide-zinc-900 border-b border-zinc-800 text-sm">
      {micros.cholesterol && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Cholesterol {micros.cholesterol.value}{micros.cholesterol.unit}</span>
          <span class="font-bold text-white">{micros.cholesterol.pctDailyValue}%</span>
        </div>
      )}
      {micros.sodium && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Sodium {micros.sodium.value}{micros.sodium.unit}</span>
          <span class="font-bold text-white">{micros.sodium.pctDailyValue}%</span>
        </div>
      )}
      {micros.potassium && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Potassium {micros.potassium.value}{micros.potassium.unit}</span>
          <span class="font-bold text-white">{micros.potassium.pctDailyValue}%</span>
        </div>
      )}
      {micros.vitaminA && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Vitamin A {micros.vitaminA.value}{micros.vitaminA.unit}</span>
          <span class="font-bold text-white">{micros.vitaminA.pctDailyValue}%</span>
        </div>
      )}
      {micros.vitaminC && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Vitamin C {micros.vitaminC.value}{micros.vitaminC.unit}</span>
          <span class="font-bold text-white">{micros.vitaminC.pctDailyValue}%</span>
        </div>
      )}
      {micros.calcium && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Calcium {micros.calcium.value}{micros.calcium.unit}</span>
          <span class="font-bold text-white">{micros.calcium.pctDailyValue}%</span>
        </div>
      )}
      {micros.iron && (
        <div class="flex justify-between py-2">
          <span class="text-zinc-300">Iron {micros.iron.value}{micros.iron.unit}</span>
          <span class="font-bold text-white">{micros.iron.pctDailyValue}%</span>
        </div>
      )}
    </div>
  )}

  <p class="text-[10px] text-zinc-500 mt-4 leading-normal">
    * The % Daily Value (DV) tells you how much a nutrient in a serving of food contributes to a daily diet. 2,000 calories a day is used for general nutrition advice.
  </p>
</div>
