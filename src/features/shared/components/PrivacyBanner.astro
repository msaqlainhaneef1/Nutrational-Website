---
import { ShieldCheck } from '@lucide/astro';
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
  <div class="glass-card rounded-3xl p-6 border border-zinc-800/80 flex flex-col md:flex-row items-center gap-4 text-center md:text-left">
    <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-2xl border border-emerald-500/20">
      <ShieldCheck class="h-6 w-6" />
    </div>
    <div class="space-y-1 flex-grow">
      <h4 class="font-bold text-white text-base">Privacy-First Platform</h4>
      <p class="text-xs text-zinc-400 leading-normal">
        We use cookie-less analytics (Umami) to track traffic. Your personal weight, health metrics, and calculations are kept entirely in your browser and never sent to a server.
      </p>
    </div>
    <a href="/privacy/" class="text-xs font-bold text-emerald-400 border border-emerald-500/20 hover:border-emerald-500/40 bg-emerald-500/5 px-4 py-2 rounded-xl transition-all">
      Privacy Policy
    </a>
  </div>
</section>
