---
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import { BookOpen } from '@lucide/astro';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <Breadcrumb items={[{ label: 'Blog', url: '/blog' }]} />

  <div class="space-y-3">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Health & Nutrition Blog</h1>
    <p class="text-zinc-400 text-sm max-w-2xl">
      Evidence-based, medically verified articles to help you achieve your dietary and metabolic goals.
    </p>
  </div>

  <!-- Blog Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="glass-card rounded-3xl p-6 border border-zinc-800 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
            <BookOpen class="h-4 w-4" />
            <span>Nutrition Guide</span>
          </div>
          <h2 class="font-extrabold text-xl text-white group-hover:text-emerald-400 transition-colors leading-tight">
            {post.data.title}
          </h2>
          <p class="text-zinc-400 text-sm leading-relaxed">{post.data.description}</p>
        </div>
        <div class="mt-8 pt-4 border-t border-zinc-900 flex items-center justify-between text-xs text-zinc-500">
          <span>By {post.data.author} • {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="text-emerald-400 font-extrabold group-hover:translate-x-1 transition-transform">Read Guide →</span>
        </div>
      </a>
    ))}
  </div>
</div>
