---
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import { CALCULATORS } from '@/features/calculators/shared/registry';
import { getAllRestaurants } from '@/features/restaurants/services/restaurant';
import { getAllFoods } from '@/features/nutrition/services/food';
import { Calculator, Utensils, Apple, ShieldCheck, UserCheck, BookOpen, Compass, Search } from '@lucide/astro';

const allRestaurants = getAllRestaurants();
const allFoods = getAllFoods();
const calculatorsList = CALCULATORS.map((c) => ({
  name: c.name,
  url: `/calculators/${c.slug}/`,
  description: c.description
}));

const trustPages = [
  { name: 'About Us', url: '/about/', desc: 'Our mission, methodology, and data sources' },
  { name: 'Contact & Support', url: '/contact/', desc: 'Submit inquiries, report data errors, or suggest features' },
  { name: 'Editorial Policy & Fact-Checking', url: '/editorial-policy/', desc: 'Clinical review standards and fact-checking protocols' },
  { name: 'Authors & Editorial Board', url: '/authors/', desc: 'Meet our credentialed dietitians and medical reviewers' },
  { name: 'Lead Reviewer: Dr. Sarah Jenkins', url: '/authors/sarah-jenkins/', desc: 'Credentials and audited formulas' },
  { name: 'Medical & Nutrition Disclaimer', url: '/disclaimer/', desc: 'Important medical limits and health guidance notices' },
  { name: 'Privacy Policy', url: '/privacy/', desc: 'User privacy, data protection, and zero-tracking commitment' },
  { name: 'Terms of Service', url: '/terms/', desc: 'Terms of use, licensing, and liability limitations' },
  { name: 'Cookie & Advertising Policy', url: '/cookie-policy/', desc: 'Cookie breakdown, AdSense disclosures, and opt-out methods' }
];
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
  <Breadcrumb items={[{ label: 'Site Directory', url: '/sitemap/' }]} />

  <!-- Header -->
  <div class="space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
      <Compass class="h-3.5 w-3.5" />
      <span>Complete Navigation Hub</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
      Site Directory & <span class="text-gradient">HTML Sitemap</span>
    </h1>
    <p class="text-zinc-400 text-base sm:text-lg leading-relaxed max-w-3xl">
      Explore all verified nutrition calculators, restaurant chain nutrition facts, whole food macro breakdowns, and legal/editorial transparency pages across Nutrition Solver.
    </p>
  </div>

  <!-- Trust, Legal & Editorial Pages -->
  <div class="glass-card rounded-2xl p-6 sm:p-8 border border-zinc-800 space-y-6">
    <div class="flex items-center gap-3">
      <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400">
        <ShieldCheck class="h-6 w-6" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white">Trust, Legal & Editorial Standards</h2>
        <p class="text-xs text-zinc-400">Governance, medical disclaimers, and reviewer credentials</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-2">
      {trustPages.map((page) => (
        <a
          href={page.url}
          class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 hover:border-emerald-500/50 hover:bg-zinc-900 transition-all space-y-1 group"
        >
          <div class="font-bold text-sm text-zinc-200 group-hover:text-emerald-400 transition-colors">
            {page.name}
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">{page.desc}</p>
        </a>
      ))}
    </div>
  </div>

  <!-- Evidence-Based Calculators -->
  <div class="glass-card rounded-2xl p-6 sm:p-8 border border-zinc-800 space-y-6">
    <div class="flex items-center gap-3">
      <div class="p-2.5 rounded-xl bg-blue-500/10 text-blue-400">
        <Calculator class="h-6 w-6" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white">Evidence-Based Health Calculators</h2>
        <p class="text-xs text-zinc-400">Clinically audited metabolic and body composition tools</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-2">
      {calculatorsList.map((c) => (
        <a
          href={c.url}
          class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 hover:border-blue-500/50 hover:bg-zinc-900 transition-all space-y-1 group"
        >
          <div class="font-bold text-sm text-zinc-200 group-hover:text-blue-400 transition-colors">
            {c.name}
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed">{c.description}</p>
        </a>
      ))}
    </div>
  </div>

  <!-- Restaurant Chain Directories -->
  <div class="glass-card rounded-2xl p-6 sm:p-8 border border-zinc-800 space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400">
          <Utensils class="h-6 w-6" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-white">Restaurant Nutrition Menus</h2>
          <p class="text-xs text-zinc-400">Official calorie and macro data for {allRestaurants.length} restaurant brands</p>
        </div>
      </div>
      <a href="/restaurants/" class="text-xs font-semibold text-emerald-400 hover:underline">View Restaurant Hub →</a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 pt-2 max-h-96 overflow-y-auto pr-2">
      {allRestaurants.map((r) => (
        <a
          href={`/restaurants/${r.slug}/`}
          class="p-2.5 rounded-lg bg-zinc-900/60 border border-zinc-800/80 hover:border-amber-500/40 text-xs text-zinc-300 hover:text-white transition-colors truncate"
          title={r.name}
        >
          {r.name}
        </a>
      ))}
    </div>
  </div>

  <!-- Whole Foods Database -->
  <div class="glass-card rounded-2xl p-6 sm:p-8 border border-zinc-800 space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-rose-500/10 text-rose-400">
          <Apple class="h-6 w-6" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-white">Whole Foods Nutrition Reference</h2>
          <p class="text-xs text-zinc-400">USDA FoodData Central reference values for whole foods</p>
        </div>
      </div>
      <a href="/foods/" class="text-xs font-semibold text-emerald-400 hover:underline">View Foods Hub →</a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 pt-2 max-h-96 overflow-y-auto pr-2">
      {allFoods.map((f) => (
        <a
          href={`/foods/${f.slug}/`}
          class="p-2.5 rounded-lg bg-zinc-900/60 border border-zinc-800/80 hover:border-rose-500/40 text-xs text-zinc-300 hover:text-white transition-colors truncate"
          title={f.name}
        >
          {f.name}
        </a>
      ))}
    </div>
  </div>
</div>
