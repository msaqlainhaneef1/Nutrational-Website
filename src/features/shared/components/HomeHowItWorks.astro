---
import { Search, Calculator, Leaf } from '@lucide/astro';

const steps = [
  {
    n: '01',
    icon: Search,
    title: 'Find your restaurant or food',
    body: 'Search 100 restaurant chains and a growing reference of whole foods. Filter by cuisine, browse categories, or just type a name. Every menu item is one click away.',
  },
  {
    n: '02',
    icon: Calculator,
    title: 'Run the numbers',
    body: 'Use the BMI, BMR, TDEE, macro, and calorie deficit calculators to understand your daily energy needs. All math runs locally in your browser. Nothing is uploaded, logged, or sold.',
  },
  {
    n: '03',
    icon: Leaf,
    title: 'Plan with confidence',
    body: 'Use the auto meal generator to compose a meal that fits your calorie and protein targets. Compare menu items against your daily goals. No email gate, no premium tier, no upsell.',
  },
];
---

<section class="py-20 border-b border-zinc-900/80 bg-zinc-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <span class="w-8 h-px bg-emerald-500/50"></span>
        <span>How it works</span>
        <span class="w-8 h-px bg-emerald-500/50"></span>
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
        Three steps from curious to informed
      </h2>
      <p class="text-zinc-400 text-sm leading-relaxed">
        No account, no setup. The site works the moment you land. Here is what a typical session looks like.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {steps.map((step) => {
        const Icon = step.icon;
        return (
          <div class="glass-card rounded-3xl p-7 relative overflow-hidden h-full">
            <div class="absolute top-4 right-5 text-6xl font-black text-zinc-900/80 select-none leading-none">
              {step.n}
            </div>
            <div class="relative z-10 space-y-4">
              <div class="p-3 w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
                <Icon class="h-6 w-6" />
              </div>
              <h3 class="font-bold text-lg text-white leading-snug">{step.title}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{step.body}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
