---
import { ShieldCheck, Lock, Eye, Cpu } from '@lucide/astro';

const principles = [
  { icon: Lock, title: 'No signup, ever', body: 'Every page, every calculator, every search is free and open. No email gate, no account, no premium tier.' },
  { icon: Eye, title: 'No tracking', body: 'No analytics cookies, no third-party scripts, no fingerprinting. Your browsing stays between you and your browser.' },
  { icon: Cpu, title: 'Local-first', body: 'Calculator math runs in JavaScript on your device. Inputs never touch a server, never get logged, never get sold.' },
];
---

<section class="py-20 border-b border-zinc-900/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div class="space-y-6">
        <div class="inline-flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/25 px-3.5 py-1.5 rounded-full text-emerald-400 text-xs font-bold uppercase tracking-wider w-fit">
          <ShieldCheck class="h-3.5 w-3.5" />
          <span>Built privacy-first</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          The nutrition site that<br/>
          <span class="text-gradient">does not track you back</span>
        </h2>
        <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
          Most nutrition sites are front-ends for ad networks. They load megabytes of tracking scripts,
          gate calculators behind email walls, and sell your data to diet supplement companies.
          Nutrition Solver is the opposite. Static HTML, zero trackers, no signup. Just the data you came for.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/restaurants/" class="inline-flex items-center space-x-1.5 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-sm rounded-xl transition-colors shadow-lg shadow-emerald-500/15">
            <span>Start browsing</span>
          </a>
          <a href="/calculators/bmi/" class="inline-flex items-center space-x-1.5 px-5 py-2.5 bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-zinc-200 font-bold text-sm rounded-xl transition-colors">
            <span>Try a calculator</span>
          </a>
        </div>
      </div>

      <div class="space-y-3">
        {principles.map((p) => {
          const Icon = p.icon;
          return (
            <div class="glass-card rounded-2xl p-5 flex items-start gap-4">
              <div class="p-2.5 bg-emerald-500/10 text-emerald-400 rounded-xl border border-emerald-500/20 flex-shrink-0">
                <Icon class="h-5 w-5" />
              </div>
              <div>
                <h3 class="font-bold text-white text-sm">{p.title}</h3>
                <p class="text-zinc-400 text-xs mt-1 leading-relaxed">{p.body}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
