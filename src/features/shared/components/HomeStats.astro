---
import { Utensils, Database, Calculator, BookOpen } from '@lucide/astro';

interface Props {
  stats: { totalRestaurants: number; totalItems: number; totalCategories: number };
}

const { stats } = Astro.props;

const formatNum = (n: number) => n.toLocaleString('en-US');

const items = [
  { icon: Utensils, label: 'Restaurant chains', value: formatNum(stats.totalRestaurants), accent: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' },
  { icon: Database, label: 'Menu items indexed', value: formatNum(stats.totalItems), accent: 'text-blue-400 bg-blue-500/10 border-blue-500/20' },
  { icon: Calculator, label: 'Free health tools', value: '9', accent: 'text-amber-400 bg-amber-500/10 border-amber-500/20' },
  { icon: BookOpen, label: 'Cuisine categories', value: String(stats.totalCategories), accent: 'text-purple-400 bg-purple-500/10 border-purple-500/20' },
];
---

<section class="border-b border-zinc-900/80 bg-zinc-950/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {items.map((item) => {
        const Icon = item.icon;
        return (
          <div class="glass-card-static rounded-2xl p-5 flex items-center gap-4">
            <div class={`p-2.5 rounded-xl border flex-shrink-0 ${item.accent}`}>
              <Icon class="h-5 w-5" />
            </div>
            <div class="min-w-0">
              <div class="text-2xl font-black text-white stat-number leading-none">{item.value}</div>
              <div class="text-xs text-zinc-500 mt-1">{item.label}</div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
