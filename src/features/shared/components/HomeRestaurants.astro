---
import { ArrowRight } from '@lucide/astro';

const restaurants = [
  { name: "McDonald's", slug: "mcdonalds", count: 5, bg: "bg-red-500/10 border-red-500/20 text-red-400" },
  { name: "Subway", slug: "subway", count: 4, bg: "bg-green-500/10 border-green-500/20 text-green-400" }
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div class="space-y-2">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">Restaurant Nutrition Calculators</h2>
      <p class="text-zinc-400 text-sm">Browse full menus, filter by category, and check calories before you order.</p>
    </div>
    <a href="/restaurants" class="inline-flex items-center text-sm font-bold text-emerald-400 hover:text-emerald-300 transition-colors">
      <span>Browse Restaurants</span>
      <ArrowRight class="h-4 w-4 ml-1.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {restaurants.map((res) => (
      <a href={`/restaurants/${res.slug}`} class="glass-card rounded-3xl p-6 border border-zinc-800 flex items-center justify-between group">
        <div class="space-y-1">
          <h3 class="font-extrabold text-xl text-white group-hover:text-emerald-400 transition-colors">{res.name}</h3>
          <p class="text-zinc-500 text-xs">{res.count} verified menu items listed</p>
        </div>
        <div class="flex items-center space-x-3">
          <span class={`text-xs px-3 py-1 rounded-full border font-bold ${res.bg}`}>
            Calorie Guide
          </span>
          <div class="p-2.5 bg-zinc-900 border border-zinc-800 rounded-xl group-hover:border-emerald-500/30 group-hover:bg-emerald-500/5 transition-all text-zinc-400 group-hover:text-emerald-400">
            <ArrowRight class="h-4 w-4" />
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
