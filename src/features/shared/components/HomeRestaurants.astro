---
import { ArrowRight } from '@lucide/astro';

const restaurants = [
  { name: "McDonald's", slug: "mcdonalds-calories-calculator", count: 48, bg: "border-red-500/30 bg-red-500/10 text-red-400" },
  { name: "Subway", slug: "subway-nutrition-calculator", count: 32, bg: "border-emerald-500/30 bg-emerald-500/10 text-emerald-450" }
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
    <div class="space-y-3">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">Restaurant Nutrition Calculators</h2>
      <p class="text-zinc-400 text-sm font-sans font-medium">Browse full menus, filter by category, and check calories before you order.</p>
    </div>
    <a href="/restaurants" class="inline-flex items-center text-sm font-bold text-emerald-400 hover:text-emerald-300 transition-colors uppercase tracking-wider font-sans group">
      <span>Browse Restaurants</span>
      <ArrowRight class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform stroke-[2.5]" />
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {restaurants.map((res) => (
      <a href={`/restaurants/${res.slug}`} class="glass-card rounded-3xl p-7 border border-zinc-900/60 flex items-center justify-between group hover:border-emerald-500/20">
        <div class="space-y-1.5">
          <h3 class="font-extrabold text-xl text-white group-hover:text-emerald-400 transition-colors font-display">{res.name}</h3>
          <p class="text-zinc-500 text-xs font-sans">{res.count} verified menu items listed</p>
        </div>
        <div class="flex items-center space-x-4">
          <span class={`text-[10px] uppercase tracking-wider px-3 py-1.5 rounded-xl border font-bold font-sans ${res.bg}`}>
            Calorie Guide
          </span>
          <div class="p-2.5 bg-zinc-900/60 border border-zinc-800 rounded-xl group-hover:border-emerald-500/30 group-hover:bg-emerald-500/10 transition-all text-zinc-400 group-hover:text-emerald-400">
            <ArrowRight class="h-4 w-4 stroke-[2.5]" />
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
