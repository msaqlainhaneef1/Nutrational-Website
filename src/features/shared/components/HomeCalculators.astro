---
import { ArrowRight, Lock } from '@lucide/astro';
import { CALCULATORS } from '@/features/calculators/shared/registry';

// Show 6 calculators on homepage (2 rows of 3)
const featured = CALCULATORS.slice(0, 6);
---

<section class="py-20 border-b border-zinc-900/80 bg-zinc-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
        <span class="w-8 h-px bg-emerald-500/50"></span>
        <span>Health calculators</span>
        <span class="w-8 h-px bg-emerald-500/50"></span>
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
        Know your numbers in seconds
      </h2>
      <p class="text-zinc-400 text-sm leading-relaxed">
        Nine clinical-grade calculators that run entirely in your browser. No data leaves your device,
        no signup required, no email gate. Pick one and start.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured.map((calc) => (
        <a
          href={`/calculators/${calc.slug}`}
          class="glass-card rounded-2xl p-5 flex flex-col group h-full relative overflow-hidden"
        >
          <div class="space-y-3 flex-1">
            <div class="flex items-start justify-between">
              <div class={`p-2.5 rounded-xl border ${calc.accent}`}>
                <span class="text-xl leading-none">{calc.icon}</span>
              </div>
            </div>
            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">{calc.tagline}</div>
              <h3 class="font-bold text-base text-white group-hover:text-emerald-400 transition-colors mt-0.5">
                {calc.name}
              </h3>
            </div>
            <p class="text-zinc-400 text-xs leading-relaxed line-clamp-2">{calc.description}</p>
          </div>

          <div class="mt-4 pt-3 border-t border-zinc-900/80 flex items-center justify-between">
            <span class="inline-flex items-center gap-1 text-[10px] text-zinc-500 font-medium">
              <Lock class="h-3 w-3" />
              Private
            </span>
            <span class="inline-flex items-center gap-1 text-xs text-emerald-400 font-bold">
              <span>Open</span>
              <ArrowRight class="h-3.5 w-3.5 transform group-hover:translate-x-1 transition-transform" />
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href="/calculators" class="inline-flex items-center space-x-1.5 px-5 py-2.5 bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-zinc-200 font-bold text-sm rounded-xl transition-colors">
        <span>View all {CALCULATORS.length} calculators</span>
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
