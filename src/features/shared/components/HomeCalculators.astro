---
import { Scale, Flame, Activity, ArrowRight } from '@lucide/astro';

const calculators = [
  {
    name: "Body Mass Index (BMI)",
    slug: "bmi",
    desc: "Calculate your body fat percentage based on height and weight.",
    icon: Scale,
    color: "text-blue-400 bg-blue-500/10 border-blue-500/20"
  },
  {
    name: "Basal Metabolic Rate (BMR)",
    slug: "bmr",
    desc: "Find out how many calories your body burns at complete rest.",
    icon: Flame,
    color: "text-amber-400 bg-amber-500/10 border-amber-500/20"
  },
  {
    name: "Total Daily Energy Expenditure (TDEE)",
    slug: "tdee",
    desc: "Discover your daily maintenance calories based on activity levels.",
    icon: Activity,
    color: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20"
  }
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
    <h2 class="text-3xl font-extrabold text-white tracking-tight">Interactive Health Calculators</h2>
    <p class="text-zinc-400 text-sm">
      Compute standard metabolic values instantly to plan deficits, surpluses, or macro allocations.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {calculators.map((calc) => {
      const Icon = calc.icon;
      return (
        <a href={`/calculators/${calc.slug}`} class="glass-card rounded-3xl p-6 border border-zinc-800 flex flex-col justify-between h-full group">
          <div class="space-y-4">
            <div class={`p-3 w-12 h-12 rounded-xl border flex items-center justify-center ${calc.color}`}>
              <Icon class="h-6 w-6" />
            </div>
            <h3 class="font-extrabold text-lg text-white group-hover:text-emerald-400 transition-colors">{calc.name}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{calc.desc}</p>
          </div>
          <div class="mt-6 pt-4 border-t border-zinc-900 flex items-center justify-between text-xs text-emerald-400 font-bold">
            <span>Compute Now</span>
            <ArrowRight class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      );
    })}
  </div>
</section>
