---
import { Search as SearchIcon, SearchCode } from '@lucide/astro';
---

<div class="space-y-6">
  <!-- Search Input -->
  <div class="relative w-full">
    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-zinc-500">
      <SearchIcon class="h-5 w-5" />
    </div>
    <input
      type="text"
      id="pagefind-search-input"
      placeholder="Type to search (apple, chicken, McDonald's, BMI, TDEE, etc)..."
      class="block w-full pl-12 pr-4 py-4 bg-zinc-900 border border-zinc-800 rounded-2xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-base transition-all font-medium"
    />
  </div>

  <!-- Loading State -->
  <div id="search-loading" class="hidden text-center py-12">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-emerald-500 mb-2"></div>
    <p class="text-xs text-zinc-500">Loading search engine...</p>
  </div>

  <!-- Search Results Container -->
  <div id="search-results" class="space-y-4 pt-4"></div>

  <!-- Empty State -->
  <div id="search-empty" class="text-center py-16 glass-card-static rounded-3xl border border-zinc-900">
    <SearchCode class="h-12 w-12 text-zinc-700 mx-auto mb-3" />
    <h3 class="font-bold text-zinc-400">Search Nutrition Solver</h3>
    <p class="text-sm text-zinc-600 mt-1 max-w-md mx-auto">
      Search is indexed at build time. If you are running locally in dev mode, run a production build to generate the search index.
    </p>
  </div>
</div>

<script is:inline>
  const searchInput = document.getElementById('pagefind-search-input');
  const resultsContainer = document.getElementById('search-results');
  const emptyState = document.getElementById('search-empty');
  const loadingState = document.getElementById('search-loading');

  let pagefind = null;

  async function initPagefind() {
    if (pagefind) return pagefind;

    try {
      loadingState.classList.remove('hidden');
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({});
      loadingState.classList.add('hidden');
      return pagefind;
    } catch (e) {
      console.warn("Pagefind index not found. This is normal in development mode since the search index is generated post-build.");
      loadingState.classList.add('hidden');
      return null;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', async (e) => {
      const query = e.target.value.trim();

      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      const pf = await initPagefind();
      if (!pf) {
        resultsContainer.innerHTML = `
          <div class="glass-card-static rounded-2xl p-6 border border-zinc-900 text-center">
            <p class="text-sm text-zinc-500 font-semibold">
              Search is not available in Development Mode. Run <code class="bg-zinc-800 text-emerald-400 px-1.5 py-0.5 rounded font-mono">npm run build</code> to index and verify the search page.
            </p>
          </div>
        `;
        emptyState.classList.add('hidden');
        return;
      }

      loadingState.classList.remove('hidden');
      const search = await pf.search(query);
      const results = await Promise.all(search.results.slice(0, 10).map((r) => r.data()));
      loadingState.classList.add('hidden');

      resultsContainer.innerHTML = '';

      if (results.length === 0) {
        resultsContainer.innerHTML = `
          <div class="glass-card-static rounded-2xl p-10 border border-zinc-900 text-center">
            <h3 class="font-bold text-zinc-400">No results found for "${query}"</h3>
            <p class="text-xs text-zinc-500 mt-1">Try another keyword or search for standard terms like 'chicken', 'apple', or 'McDonald's'.</p>
          </div>
        `;
        emptyState.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      results.forEach((res) => {
        const card = document.createElement('a');
        card.href = res.url;
        card.className = 'glass-card rounded-2xl p-5 border border-zinc-800/80 block hover:border-emerald-500/20 hover:bg-emerald-500/5 transition-all duration-300';

        card.innerHTML = `
          <div class="space-y-1">
            <h3 class="font-bold text-white text-base">${res.meta.title || 'Untitled Page'}</h3>
            <p class="text-zinc-400 text-xs leading-relaxed">${res.excerpt || ''}</p>
            <span class="inline-flex items-center text-[10px] text-emerald-400 font-semibold pt-1">
              ${res.url}
            </span>
          </div>
        `;

        resultsContainer.appendChild(card);
      });
    });
  }
</script>
