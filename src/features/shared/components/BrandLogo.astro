---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  class?: string;
}

const { size = 'md', showText = true, class: className = '' } = Astro.props;

const sizeMap = {
  sm: { box: 'w-7 h-7', icon: 'h-4 w-4', text: 'text-base' },
  md: { box: 'w-9 h-9', icon: 'h-5 w-5', text: 'text-lg' },
  lg: { box: 'w-12 h-12', icon: 'h-7 w-7', text: 'text-2xl' },
};

const s = sizeMap[size];
---

<a href="/" class={`flex items-center space-x-2.5 group ${className}`}>
  <span class={`inline-flex items-center justify-center ${s.box} rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition-shadow`}>
    <svg viewBox="0 0 64 64" class={s.icon} fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Leaf shape -->
      <path d="M 18 44 Q 16 30 26 22 Q 36 14 44 18 Q 42 30 32 38 Q 24 44 18 44 Z" fill="white"/>
      <!-- Leaf vein -->
      <path d="M 22 42 Q 30 32 42 20" stroke="#10b981" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      <!-- Checkmark -->
      <path d="M 38 38 L 44 44 L 54 30" stroke="white" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
  {showText && (
    <span class={`font-extrabold ${s.text} tracking-tight text-white`}>Nutrition Solver</span>
  )}
</a>
