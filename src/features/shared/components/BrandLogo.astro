---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  class?: string;
}

const { size = 'md', showText = true, class: className = '' } = Astro.props;

const sizeMap = {
  sm: { box: 'w-7 h-7', icon: 'h-4 w-4', text: 'text-base' },
  md: { box: 'w-9 h-9', icon: 'h-5 w-5', text: 'text-lg' },
  lg: { box: 'w-12 h-12', icon: 'h-7 w-7', text: 'text-2xl' },
};

const s = sizeMap[size];
---

<a href="/" class={`flex items-center space-x-2.5 group ${className}`}>
  <span class={`inline-flex items-center justify-center ${s.box} rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition-shadow`}>
    <svg viewBox="0 0 64 64" class={s.icon} fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Symmetric geometric leaf outline with subtle glassmorphic fill -->
      <path d="M 32 6 C 14 18 14 46 32 58 C 50 46 50 18 32 6 Z" fill="rgba(255, 255, 255, 0.15)" stroke="white" stroke-width="4.5" stroke-linejoin="round"/>
      <!-- Center stem/vein -->
      <path d="M 32 58 L 32 44" stroke="white" stroke-width="4.5" stroke-linecap="round"/>
      <!-- Integrated bold checkmark representing solver -->
      <path d="M 18 30 L 28 42 L 48 18" stroke="white" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
  {showText && (
    <span class={`font-extrabold ${s.text} tracking-tight text-zinc-100`}>
      Nutrition <span class="text-emerald-600">Solver</span>
    </span>
  )}
</a>
