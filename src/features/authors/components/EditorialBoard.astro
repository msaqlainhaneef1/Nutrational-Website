---
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import { Award, ShieldCheck, ArrowRight, BookOpen, Stethoscope, Users } from '@lucide/astro';

const reviewers = [
  {
    name: 'Dr. Sarah Jenkins',
    slug: 'sarah-jenkins',
    role: 'Lead Clinical Nutrition Reviewer',
    credentials: 'PhD, RDN, LDN',
    bio: 'Specialist in metabolic rate formulas, energy expenditure equations, and evidence-based macronutrient distributions.',
    focus: ['BMR / TDEE Calculations', 'Macro Distribution', 'Clinical Dietetics'],
    profileUrl: '/authors/sarah-jenkins/'
  },
  {
    name: 'Nutrition Solver Data & Research Team',
    slug: 'editorial-team',
    role: 'Nutritional Database Researchers',
    credentials: 'Data Science & Nutritional Informatics',
    bio: 'Continuous verification and auditing of over 100 restaurant chain nutrition disclosures and USDA FoodData Central tables.',
    focus: ['Restaurant Menu Disclosures', 'USDA FoodData Central', 'Portion Standardization'],
    profileUrl: '/editorial-policy/'
  }
];

const reviewGuidelines = [
  {
    title: 'Evidence-Based Equations Only',
    desc: 'We strictly reject untested social media trends. All formulas rely on peer-reviewed literature such as Mifflin-St Jeor, Harris-Benedict, and Katch-McArdle.'
  },
  {
    title: 'Zero Sponsored Bias',
    desc: 'No restaurant or food brand pays for inclusion, higher health scores, or altered nutritional numbers on our website.'
  },
  {
    title: 'Routine Audits & Re-Verification',
    desc: 'Our nutrition databases undergo scheduled audits to detect menu formulation changes across national chains.'
  }
];
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
  <Breadcrumb items={[{ label: 'Authors & Editorial Board', url: '/authors/' }]} />

  <!-- Hero Header -->
  <div class="space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
      <Users class="h-3.5 w-3.5" />
      <span>Medical & Nutritional Review Board</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
      Our Authors & <span class="text-gradient">Medical Reviewers</span>
    </h1>
    <p class="text-zinc-400 text-base sm:text-lg leading-relaxed max-w-3xl">
      Behind every calculator, nutritional table, and dietary reference is a team of credentialed dietitians and data analysts dedicated to accuracy, clarity, and patient safety.
    </p>
  </div>

  <!-- Reviewers Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {reviewers.map((rev) => (
      <div class="glass-card rounded-2xl p-6 sm:p-7 border border-zinc-800 hover:border-emerald-500/40 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="h-16 w-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
              <span class="text-xl font-bold text-emerald-400">
                {rev.name.split(' ').map(n => n[0]).slice(0, 2).join('')}
              </span>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">{rev.name}</h3>
              <p class="text-xs font-semibold text-emerald-400">{rev.credentials}</p>
              <p class="text-xs text-zinc-400 mt-0.5">{rev.role}</p>
            </div>
          </div>

          <p class="text-sm text-zinc-300 leading-relaxed">{rev.bio}</p>

          <div class="space-y-1.5 pt-1">
            <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Key Expertise:</p>
            <div class="flex flex-wrap gap-1.5">
              {rev.focus.map((f) => (
                <span class="text-xs px-2.5 py-0.5 rounded-md bg-zinc-900 border border-zinc-800 text-zinc-300">{f}</span>
              ))}
            </div>
          </div>
        </div>

        <div class="pt-2 border-t border-zinc-800/80">
          <a
            href={rev.profileUrl}
            class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
          >
            <span>View Full Profile & Audited Work</span>
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Review Standards -->
  <div class="glass-card rounded-2xl p-6 sm:p-8 border border-zinc-800 space-y-6">
    <div class="space-y-2">
      <h2 class="text-2xl font-bold text-white flex items-center gap-2">
        <ShieldCheck class="h-6 w-6 text-emerald-400" />
        Our Editorial Standards
      </h2>
      <p class="text-sm text-zinc-400 leading-relaxed">
        How our board guarantees reliability across thousands of menu items and formulas:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      {reviewGuidelines.map((g) => (
        <div class="p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80 space-y-2">
          <h4 class="text-sm font-bold text-emerald-400">{g.title}</h4>
          <p class="text-xs text-zinc-400 leading-relaxed">{g.desc}</p>
        </div>
      ))}
    </div>
  </div>
</div>
