---
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import AuthorBox from '@/features/authors/components/AuthorBox.astro';
import { ArrowLeft, ShieldCheck, Clock, BookOpen } from '@lucide/astro';
import type { CalculatorMeta } from '../registry';

interface Props {
  meta: CalculatorMeta;
  about: string;
  sections?: { heading: string; body: string[] }[];
  faqs?: { q: string; a: string }[];
}

const { meta, about, sections = [], faqs = [] } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
  <div class="flex items-center justify-between">
    <Breadcrumb items={[
      { label: 'Calculators', url: '/calculators' },
      { label: meta.shortName }
    ]} />
    <a href="/calculators" class="inline-flex items-center text-xs text-zinc-400 hover:text-emerald-400 font-semibold transition-colors">
      <ArrowLeft class="h-3.5 w-3.5 mr-1" />
      All calculators
    </a>
  </div>

  <!-- Calculator + about sidebar -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-8 space-y-6">
      <div class="space-y-4">
        <div class="flex items-start gap-4">
          <span class="text-5xl leading-none">{meta.icon}</span>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">{meta.tagline}</div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-0.5">{meta.name}</h1>
          </div>
        </div>
        <p class="text-zinc-400 text-sm md:text-base leading-relaxed max-w-2xl">{meta.description}</p>
        <div class="flex items-center gap-4 text-xs text-zinc-500 pt-1">
          <span class="inline-flex items-center gap-1.5">
            <ShieldCheck class="h-3.5 w-3.5 text-emerald-500" />
            Runs in your browser
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock class="h-3.5 w-3.5" />
            Updated July 2026
          </span>
          <span class="inline-flex items-center gap-1.5">
            <BookOpen class="h-3.5 w-3.5" />
            Reviewed by Dr. Sarah Jenkins
          </span>
        </div>
      </div>

      <!-- Calculator widget (slot) -->
      <slot />
    </div>

    <aside class="lg:col-span-4 space-y-5 lg:sticky lg:top-24">
      <div class="glass-card-static rounded-2xl p-6 space-y-3">
        <div class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-emerald-400">
          <BookOpen class="h-3 w-3" />
          About this calculator
        </div>
        <p class="text-zinc-300 text-sm leading-relaxed">{about}</p>
      </div>

      <AuthorBox
        name="Dr. Sarah Jenkins"
        role="Clinical Dietitian and Nutritionist"
        bio="Reviewed and verified the mathematical accuracy of health formulas used in our calculator modules."
      />
    </aside>
  </div>

  <!-- Long-form educational sections -->
  {sections.length > 0 && (
    <div class="max-w-3xl mx-auto space-y-10 pt-10 border-t border-zinc-900">
      {sections.map((section) => (
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">{section.heading}</h2>
          {section.body.map((para) => (
            <p class="text-zinc-400 text-sm md:text-base leading-relaxed">{para}</p>
          ))}
        </section>
      ))}
    </div>
  )}

  <!-- FAQ -->
  {faqs.length > 0 && (
    <div class="max-w-3xl mx-auto space-y-4 pt-10 border-t border-zinc-900">
      <div class="space-y-1">
        <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Frequently asked questions</h2>
        <p class="text-zinc-500 text-sm">Quick answers to the most common questions about this calculator.</p>
      </div>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="glass-card-static rounded-xl p-5 group" open={i === 0}>
            <summary class="font-bold text-white text-sm cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.q}</span>
              <span class="text-zinc-500 transition-transform group-open:rotate-45 text-xl leading-none flex-shrink-0">+</span>
            </summary>
            <p class="text-zinc-400 text-sm leading-relaxed mt-3">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  )}
</div>
