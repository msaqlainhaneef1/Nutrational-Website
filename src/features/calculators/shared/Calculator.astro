---
import { Calculator as CalcIcon, Scale, Flame, Activity } from '@lucide/astro';

interface Props {
  type: 'bmi' | 'bmr' | 'tdee';
}

const { type } = Astro.props;

const titleMap = {
  bmi: "Body Mass Index (BMI)",
  bmr: "Basal Metabolic Rate (BMR)",
  tdee: "Total Daily Energy Expenditure (TDEE)",
};
---

<div class="glass-card rounded-3xl p-6 md:p-8 max-w-2xl mx-auto border border-zinc-800" data-calc-type={type}>
  <div class="flex items-center space-x-3 border-b border-zinc-900 pb-5 mb-6">
    <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-2xl border border-emerald-500/20">
      {type === 'bmi' && <Scale class="h-6 w-6" />}
      {type === 'bmr' && <Flame class="h-6 w-6" />}
      {type === 'tdee' && <Activity class="h-6 w-6" />}
    </div>
    <div>
      <h3 class="font-extrabold text-xl text-white tracking-tight">{titleMap[type]}</h3>
      <p class="text-zinc-500 text-xs mt-0.5">Calculate your personalized health metrics instantly</p>
    </div>
  </div>

  <form id={`calc-form-${type}`} class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {type !== 'bmi' && (
        <div class="space-y-2 md:col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Gender</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center justify-center p-3 rounded-xl border border-zinc-800 bg-zinc-900/40 text-sm font-semibold cursor-pointer hover:border-zinc-700 transition-all select-none gap-2">
              <input type="radio" name="gender" value="male" checked class="accent-emerald-500" />
              <span class="text-zinc-200">Male</span>
            </label>
            <label class="flex items-center justify-center p-3 rounded-xl border border-zinc-800 bg-zinc-900/40 text-sm font-semibold cursor-pointer hover:border-zinc-700 transition-all select-none gap-2">
              <input type="radio" name="gender" value="female" class="accent-emerald-500" />
              <span class="text-zinc-200">Female</span>
            </label>
          </div>
        </div>
      )}

      <div class="space-y-2">
        <label for={`weight-${type}`} class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Weight (kg)</label>
        <input
          type="number"
          id={`weight-${type}`}
          name="weight"
          required
          min="10"
          max="300"
          step="0.1"
          placeholder="e.g. 70"
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 text-sm transition-all"
        />
      </div>

      <div class="space-y-2">
        <label for={`height-${type}`} class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Height (cm)</label>
        <input
          type="number"
          id={`height-${type}`}
          name="height"
          required
          min="50"
          max="250"
          step="1"
          placeholder="e.g. 175"
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 text-sm transition-all"
        />
      </div>

      {type !== 'bmi' && (
        <div class="space-y-2">
          <label for={`age-${type}`} class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Age (years)</label>
          <input
            type="number"
            id={`age-${type}`}
            name="age"
            required
            min="1"
            max="120"
            step="1"
            placeholder="e.g. 28"
            class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 text-sm transition-all"
          />
        </div>
      )}

      {type === 'tdee' && (
        <div class="space-y-2">
          <label for={`activity-${type}`} class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Activity Level</label>
          <select
            id={`activity-${type}`}
            name="activity"
            required
            class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 text-sm transition-all appearance-none"
          >
            <option value="sedentary">Sedentary (Little or no exercise)</option>
            <option value="light">Lightly Active (Exercise 1-3 days/wk)</option>
            <option value="moderate" selected>Moderately Active (Exercise 3-5 days/wk)</option>
            <option value="active">Very Active (Hard exercise 6-7 days/wk)</option>
            <option value="extreme">Extra Active (Heavy physical job/training)</option>
          </select>
        </div>
      )}
    </div>

    <button
      type="submit"
      class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-extrabold text-sm uppercase tracking-wider rounded-xl cursor-pointer shadow-lg shadow-emerald-500/15 hover:shadow-emerald-500/25 transition-all flex items-center justify-center space-x-2"
      id={`calc-submit-btn-${type}`}
    >
      <CalcIcon class="h-4 w-4" />
      <span>Calculate Results</span>
    </button>
  </form>

  <div id={`calc-results-${type}`} class="hidden mt-8 border-t border-zinc-900 pt-6 animate-fade-in">
    <h4 class="font-extrabold text-lg text-white mb-4">Your Calculations</h4>
    
    {type === 'bmi' && (
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">BMI Score</span>
            <span class="text-4xl font-black text-emerald-400 mt-1 block" id="bmi-val">--</span>
          </div>
          <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">Category</span>
            <span class="text-lg font-black text-white mt-2 block" id="bmi-cat">--</span>
          </div>
        </div>
        <div class="p-4 bg-zinc-900/40 border border-zinc-800/60 rounded-2xl text-xs text-zinc-400 leading-relaxed">
          For your height, a healthy weight range is <strong class="text-zinc-200" id="bmi-range">--</strong>.
        </div>
      </div>
    )}

    {type === 'bmr' && (
      <div class="space-y-4">
        <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">Basal Metabolic Rate (BMR)</span>
            <p class="text-xs text-zinc-400 mt-1 max-w-sm">Calories burned at complete rest to maintain vital functions.</p>
          </div>
          <span class="text-4xl font-black text-emerald-400" id="bmr-val">-- kcal</span>
        </div>
      </div>
    )}

    {type === 'tdee' && (
      <div class="space-y-5">
        <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">Daily Maintenance Calories</span>
            <p class="text-xs text-zinc-400 mt-1 max-w-sm">Daily calories required to maintain your current weight.</p>
          </div>
          <span class="text-4xl font-black text-emerald-400" id="tdee-val">-- kcal</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">Weight Loss (-500 kcal)</span>
            <span class="text-xl font-extrabold text-blue-400 mt-1 block" id="tdee-loss">-- kcal</span>
            <span class="text-[10px] text-zinc-500 mt-1 block">To lose ~0.5kg per week safely</span>
          </div>
          <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">Weight Gain (+500 kcal)</span>
            <span class="text-xl font-extrabold text-amber-400 mt-1 block" id="tdee-gain">-- kcal</span>
            <span class="text-[10px] text-zinc-500 mt-1 block">To gain weight or build muscle</span>
          </div>
        </div>
      </div>
    )}
  </div>
</div>

<script>
  import { calculateBMI } from '../bmi/bmi';
  import { calculateBMR } from '../bmr/bmr';
  import { calculateTDEE, type ActivityLevel } from '../tdee/tdee';

  const type = document.querySelector('[data-calc-type]')?.getAttribute('data-calc-type');
  
  if (type) {
    const form = document.getElementById(`calc-form-${type}`) as HTMLFormElement;
    const results = document.getElementById(`calc-results-${type}`);

    if (form && results) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const weight = parseFloat(formData.get('weight') as string);
        const height = parseFloat(formData.get('height') as string);

        if (type === 'bmi') {
          const res = calculateBMI(weight, height);
          const valEl = document.getElementById('bmi-val');
          const catEl = document.getElementById('bmi-cat');
          const rangeEl = document.getElementById('bmi-range');

          if (valEl) valEl.textContent = res.bmi.toString();
          if (catEl) {
            catEl.textContent = res.category;
            catEl.className = 'text-lg font-black mt-2 block ';
            if (res.category === 'Normal weight') {
              catEl.classList.add('text-emerald-400');
            } else if (res.category === 'Underweight') {
              catEl.classList.add('text-blue-400');
            } else if (res.category === 'Overweight') {
              catEl.classList.add('text-amber-400');
            } else {
              catEl.classList.add('text-red-400');
            }
          }
          if (rangeEl) rangeEl.textContent = `${res.minHealthyWeight}kg - ${res.maxHealthyWeight}kg`;
        } else if (type === 'bmr') {
          const age = parseInt(formData.get('age') as string);
          const gender = formData.get('gender') as 'male' | 'female';
          const res = calculateBMR(weight, height, age, gender);
          const valEl = document.getElementById('bmr-val');
          if (valEl) valEl.textContent = `${res.bmr} kcal`;
        } else if (type === 'tdee') {
          const age = parseInt(formData.get('age') as string);
          const gender = formData.get('gender') as 'male' | 'female';
          const activity = formData.get('activity') as ActivityLevel;
          const res = calculateTDEE(weight, height, age, gender, activity);

          const valEl = document.getElementById('tdee-val');
          const lossEl = document.getElementById('tdee-loss');
          const gainEl = document.getElementById('tdee-gain');

          if (valEl) valEl.textContent = `${res.maintenanceCalories} kcal`;
          if (lossEl) lossEl.textContent = `${res.weightLossCalories} kcal`;
          if (gainEl) gainEl.textContent = `${res.weightGainCalories} kcal`;
        }

        results.classList.remove('hidden');
        results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }
  }
</script>
