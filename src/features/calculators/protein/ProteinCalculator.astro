---
import { Calculator as CalcIcon } from '@lucide/astro';
---

<div class="glass-card rounded-3xl p-6 md:p-8 border border-zinc-800">
  <div class="flex items-center space-x-3 border-b border-zinc-900 pb-5 mb-6">
    <div class="p-3 bg-rose-500/10 text-rose-400 rounded-2xl border border-rose-500/20">
      <CalcIcon class="h-6 w-6" />
    </div>
    <div>
      <h3 class="font-extrabold text-xl text-white tracking-tight">Protein calculator</h3>
      <p class="text-zinc-500 text-xs mt-0.5">Daily protein target in grams</p>
    </div>
  </div>

  <form id="calc-form-protein" class="space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="space-y-2">
        <label for="weight-protein" class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Weight (kg)</label>
        <input type="number" id="weight-protein" name="weight" required min="30" max="300" step="0.1" placeholder="e.g. 75"
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all" />
      </div>
      <div class="space-y-2">
        <label for="activity-protein" class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Activity level</label>
        <select id="activity-protein" name="activity" required
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all appearance-none">
          <option value="sedentary">Sedentary (no exercise)</option>
          <option value="light">Lightly active (1 to 3 days/week)</option>
          <option value="moderate" selected>Moderately active (3 to 5 days/week)</option>
          <option value="active">Very active (6 to 7 days/week)</option>
          <option value="extreme">Extra active (athlete or physical job)</option>
        </select>
      </div>
      <div class="space-y-2 md:col-span-2">
        <label for="goal-protein" class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Fitness goal</label>
        <select id="goal-protein" name="goal" required
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all appearance-none">
          <option value="loss">Lose weight (preserve muscle)</option>
          <option value="maintenance" selected>Maintain weight</option>
          <option value="gain">Build muscle</option>
        </select>
      </div>
    </div>

    <button type="submit"
      class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-extrabold text-sm uppercase tracking-wider rounded-xl cursor-pointer shadow-lg shadow-emerald-500/15 hover:shadow-emerald-500/25 transition-all flex items-center justify-center space-x-2">
      <CalcIcon class="h-4 w-4" />
      <span>Calculate protein target</span>
    </button>
  </form>

  <div id="calc-results-protein" class="hidden mt-8 border-t border-zinc-900 pt-6">
    <h4 class="font-extrabold text-lg text-white mb-4">Your daily protein target</h4>

    <div class="bg-zinc-900/60 border border-zinc-800 p-6 rounded-2xl mb-4 text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 block">Recommended daily intake</span>
      <span class="text-5xl font-black text-rose-400 mt-2 block" id="protein-target">--</span>
      <span class="text-sm text-zinc-500 mt-1 block" id="protein-perkg-display">--</span>
    </div>

    <div class="grid grid-cols-2 gap-3 mb-5">
      <div class="bg-zinc-900/60 border border-zinc-800 p-4 rounded-2xl text-center">
        <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500 block">Minimum</span>
        <span class="text-2xl font-black text-zinc-300 mt-1 block" id="protein-low">--</span>
      </div>
      <div class="bg-zinc-900/60 border border-zinc-800 p-4 rounded-2xl text-center">
        <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500 block">Upper end</span>
        <span class="text-2xl font-black text-zinc-300 mt-1 block" id="protein-high">--</span>
      </div>
    </div>

    <div class="mt-5 p-4 bg-rose-500/5 border border-rose-500/20 rounded-2xl">
      <p class="text-xs text-rose-200 leading-relaxed" id="protein-recommendation"></p>
    </div>

    <div class="mt-3 p-4 bg-zinc-900/40 border border-zinc-800/60 rounded-2xl">
      <p class="text-xs text-zinc-400 leading-relaxed">
        <strong class="text-zinc-300">For context:</strong> A typical chicken breast contains about 30 grams of protein per 100 grams. A large egg has about 6 grams. A cup of Greek yogurt has about 20 grams. Use the foods reference on this site to look up protein content for any whole food.
      </p>
    </div>
  </div>
</div>

<script>
  import { calculateProtein } from './protein';

  const form = document.getElementById('calc-form-protein') as HTMLFormElement;
  const results = document.getElementById('calc-results-protein');

  if (form && results) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const weight = parseFloat(fd.get('weight') as string);
      const activity = fd.get('activity') as any;
      const goal = fd.get('goal') as any;

      if (!weight) return;

      const r = calculateProtein(weight, goal, activity);

      const set = (id: string, val: string | number) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(val);
      };

      set('protein-target', r.proteinGrams + ' g');
      set('protein-perkg-display', r.proteinPerKg + ' grams per kg of body weight');
      set('protein-low', r.lowEnd + ' g');
      set('protein-high', r.highEnd + ' g');

      const rec = document.getElementById('protein-recommendation');
      if (rec) rec.textContent = r.recommendation;

      results.classList.remove('hidden');
      results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>
