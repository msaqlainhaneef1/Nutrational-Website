---
import { Calculator as CalcIcon } from '@lucide/astro';
---

<div class="glass-card rounded-3xl p-6 md:p-8 border border-zinc-800">
  <div class="flex items-center space-x-3 border-b border-zinc-900 pb-5 mb-6">
    <div class="p-3 bg-cyan-500/10 text-cyan-400 rounded-2xl border border-cyan-500/20">
      <CalcIcon class="h-6 w-6" />
    </div>
    <div>
      <h3 class="font-extrabold text-xl text-white tracking-tight">Water intake calculator</h3>
      <p class="text-zinc-500 text-xs mt-0.5">Daily hydration target based on body weight</p>
    </div>
  </div>

  <form id="calc-form-water" class="space-y-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="space-y-2">
        <label for="weight-water" class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Weight (kg)</label>
        <input type="number" id="weight-water" name="weight" required min="20" max="300" step="0.1" placeholder="e.g. 75"
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all" />
      </div>
      <div class="space-y-2">
        <label for="activity-water" class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Activity level</label>
        <select id="activity-water" name="activity" required
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all appearance-none">
          <option value="sedentary">Sedentary (desk job, little movement)</option>
          <option value="light">Lightly active (light exercise 1 to 3 days/week)</option>
          <option value="moderate" selected>Moderately active (exercise 3 to 5 days/week)</option>
          <option value="active">Very active (exercise 6 to 7 days/week)</option>
          <option value="extreme">Extra active (physical job, athlete)</option>
        </select>
      </div>
      <div class="space-y-2 md:col-span-2">
        <label for="climate-water" class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Climate</label>
        <select id="climate-water" name="climate" required
          class="w-full px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all appearance-none">
          <option value="temperate" selected>Temperate (typical indoor climate)</option>
          <option value="hot">Hot (above 27 C / 80 F most of the year)</option>
          <option value="cold">Cold (below 10 C / 50 F most of the year)</option>
        </select>
      </div>
    </div>

    <button type="submit"
      class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-extrabold text-sm uppercase tracking-wider rounded-xl cursor-pointer shadow-lg shadow-emerald-500/15 hover:shadow-emerald-500/25 transition-all flex items-center justify-center space-x-2">
      <CalcIcon class="h-4 w-4" />
      <span>Calculate water intake</span>
    </button>
  </form>

  <div id="calc-results-water" class="hidden mt-8 border-t border-zinc-900 pt-6">
    <h4 class="font-extrabold text-lg text-white mb-4">Your daily water target</h4>

    <div class="grid grid-cols-3 gap-3 mb-5">
      <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl text-center">
        <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500 block">Liters</span>
        <span class="text-3xl font-black text-cyan-400 mt-1 block" id="water-liters">--</span>
      </div>
      <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl text-center">
        <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500 block">Ounces</span>
        <span class="text-3xl font-black text-cyan-400 mt-1 block" id="water-oz">--</span>
      </div>
      <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl text-center">
        <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500 block">Glasses</span>
        <span class="text-3xl font-black text-cyan-400 mt-1 block" id="water-glasses">--</span>
        <span class="text-[10px] text-zinc-600">250 ml each</span>
      </div>
    </div>

    <div class="mt-5 p-4 bg-cyan-500/5 border border-cyan-500/20 rounded-2xl">
      <p class="text-xs text-cyan-200 leading-relaxed" id="water-recommendation"></p>
    </div>

    <div class="mt-3 p-4 bg-zinc-900/40 border border-zinc-800/60 rounded-2xl">
      <p class="text-xs text-zinc-400 leading-relaxed">
        <strong class="text-zinc-300">Good to know:</strong> About 20 percent of your daily water comes from food (especially fruits, vegetables, and soups). The numbers above are for additional fluid intake from drinks. Caffeinated beverages count toward hydration, though water is still the best choice.
      </p>
    </div>
  </div>
</div>

<script>
  import { calculateWater } from './water';

  const form = document.getElementById('calc-form-water') as HTMLFormElement;
  const results = document.getElementById('calc-results-water');

  if (form && results) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const weight = parseFloat(fd.get('weight') as string);
      const activity = fd.get('activity') as any;
      const climate = fd.get('climate') as any;

      if (!weight) return;

      const r = calculateWater(weight, activity, climate);

      const set = (id: string, val: string | number) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(val);
      };

      set('water-liters', r.adjustedLiters + ' L');
      set('water-oz', r.adjustedOz + ' oz');
      set('water-glasses', r.glasses);

      const rec = document.getElementById('water-recommendation');
      if (rec) rec.textContent = r.recommendation;

      results.classList.remove('hidden');
      results.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>
