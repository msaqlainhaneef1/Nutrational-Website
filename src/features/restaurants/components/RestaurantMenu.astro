---
import { Search, Flame, CircleAlert, Filter, X, Plus } from '@lucide/astro';
import type { Restaurant } from '../schemas/restaurant';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;

// Compute aggregate stats
const allItems = restaurant.categories.flatMap((c) => c.items);
const totalItems = allItems.length;
const avgCalories = totalItems > 0 ? Math.round(allItems.reduce((s, i) => s + i.calories, 0) / totalItems) : 0;
const maxCalories = totalItems > 0 ? Math.max(...allItems.map((i) => i.calories)) : 0;
const minCalories = totalItems > 0 ? Math.min(...allItems.filter((i) => i.calories > 0).map((i) => i.calories)) : 0;
const lowCalCount = allItems.filter((i) => i.calories > 0 && i.calories < 400).length;
const highProteinCount = allItems.filter((i) => i.protein >= 20).length;
const topProteinItem = allItems.length > 0 ? allItems.reduce((max, i) => (i.protein > max.protein ? i : max)) : null;
---

<div class="space-y-6">
  <!-- Quick stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div class="glass-card rounded-xl p-4">
      <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">Items on menu</div>
      <div class="text-2xl font-black text-white mt-1 stat-number">{totalItems}</div>
    </div>
    <div class="glass-card rounded-xl p-4">
      <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">Avg calories</div>
      <div class="text-2xl font-black text-emerald-400 mt-1 stat-number">{avgCalories}</div>
    </div>
    <div class="glass-card rounded-xl p-4">
      <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">Under 400 cal</div>
      <div class="text-2xl font-black text-blue-400 mt-1 stat-number">{lowCalCount}</div>
    </div>
    <div class="glass-card rounded-xl p-4">
      <div class="text-[10px] uppercase font-bold tracking-wider text-zinc-500">High protein (20g+)</div>
      <div class="text-2xl font-black text-amber-400 mt-1 stat-number">{highProteinCount}</div>
    </div>
  </div>

  <!-- Search + Filter bar -->
  <div class="glass-card rounded-2xl p-4 space-y-3">
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-500">
        <Search class="h-4 w-4" />
      </div>
      <input
        type="text"
        id="menu-search-input"
        placeholder={`Search ${totalItems} items in ${restaurant.name}...`}
        class="block w-full pl-10 pr-10 py-2.5 bg-zinc-900 border border-zinc-800 rounded-xl text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all"
      />
      <button id="menu-clear-search" type="button" class="hidden absolute inset-y-0 right-0 pr-3 text-zinc-500 hover:text-white">
        <X class="h-4 w-4" />
      </button>
    </div>

    <div class="flex items-center gap-1.5 flex-wrap">
      <div class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-zinc-500 mr-1">
        <Filter class="h-3 w-3" />
        <span>Category:</span>
      </div>
      <button data-category="all" class="menu-cat-pill active px-3 py-1.5 rounded-lg text-xs font-semibold border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 transition-all">
        All <span class="opacity-60">{totalItems}</span>
      </button>
      {restaurant.categories.map((cat) => (
        <button
          data-category={cat.name}
          class="menu-cat-pill px-3 py-1.5 rounded-lg text-xs font-semibold border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-zinc-200 hover:border-zinc-700 transition-all"
        >
          {cat.name} <span class="opacity-60">{cat.items.length}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Menu grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="menu-items-grid">
    {restaurant.categories.flatMap((cat) =>
      cat.items.map((item, idx) => {
        const itemId = `${cat.name}::${item.name}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        return (
          <div
            class="menu-item-card glass-card rounded-2xl p-4 flex flex-col border border-zinc-800/60 transition-all"
            data-item-name={item.name.toLowerCase()}
            data-item-category={cat.name}
            data-item-cal={item.calories}
            data-item-pro={item.protein}
            data-item-carb={item.carbs}
            data-item-fat={item.fat}
            data-item-id={itemId}
          >
            <div class="flex justify-between items-start gap-3 mb-3">
              <div class="flex-grow min-w-0">
                <h4 class="font-bold text-white text-sm leading-snug">{item.name}</h4>
                {item.servingSize && (
                  <p class="text-[11px] text-zinc-500 mt-0.5">Serving: {item.servingSize}</p>
                )}
              </div>
              <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20 flex-shrink-0">
                <Flame class="h-3 w-3 fill-amber-500" />
                {item.calories} cal
              </span>
            </div>

            <div class="grid grid-cols-4 gap-1.5 text-center">
              <div class="bg-zinc-900/60 py-1.5 px-1 rounded-md border border-zinc-900">
                <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-500">Protein</div>
                <div class="text-sm font-extrabold text-emerald-400">{item.protein}g</div>
              </div>
              <div class="bg-zinc-900/60 py-1.5 px-1 rounded-md border border-zinc-900">
                <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-500">Carbs</div>
                <div class="text-sm font-extrabold text-blue-400">{item.carbs}g</div>
              </div>
              <div class="bg-zinc-900/60 py-1.5 px-1 rounded-md border border-zinc-900">
                <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-500">Fat</div>
                <div class="text-sm font-extrabold text-amber-400">{item.fat}g</div>
              </div>
              <div class="bg-zinc-900/60 py-1.5 px-1 rounded-md border border-zinc-900">
                <div class="text-[9px] uppercase font-bold tracking-wider text-zinc-500">Sodium</div>
                <div class="text-sm font-extrabold text-zinc-300">{item.sodium != null ? `${Math.round(item.sodium)}mg` : '--'}</div>
              </div>
            </div>

            {(item.sugars != null || item.cholesterol != null || item.fiber != null) && (
              <div class="mt-2 flex items-center gap-2 flex-wrap text-[10px] text-zinc-500">
                {item.fiber != null && <span class="inline-flex items-center gap-0.5">Fiber: <span class="text-zinc-300 font-semibold">{item.fiber}g</span></span>}
                {item.sugars != null && <span class="inline-flex items-center gap-0.5">Sugars: <span class="text-zinc-300 font-semibold">{item.sugars}g</span></span>}
                {item.cholesterol != null && <span class="inline-flex items-center gap-0.5">Chol: <span class="text-zinc-300 font-semibold">{Math.round(item.cholesterol)}mg</span></span>}
                {item.saturated_fat != null && <span class="inline-flex items-center gap-0.5">Sat fat: <span class="text-zinc-300 font-semibold">{item.saturated_fat}g</span></span>}
              </div>
            )}

            <!-- Add to meal button -->
            <button
              type="button"
              class="mt-3 add-to-meal-btn flex items-center justify-center gap-1.5 w-full py-2 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 hover:border-emerald-500/40 text-emerald-400 text-xs font-bold rounded-lg transition-all"
              data-name={item.name}
              data-cal={item.calories}
              data-pro={item.protein}
              data-carb={item.carbs}
              data-fat={item.fat}
              data-id={itemId}
              data-source={restaurant.name}
            >
              <Plus class="h-3.5 w-3.5" />
              <span>Add to meal</span>
            </button>
          </div>
        );
      })
    )}
  </div>

  <!-- Empty state -->
  <div id="menu-empty-state" class="hidden glass-card rounded-2xl p-10 text-center">
    <CircleAlert class="h-10 w-10 text-zinc-600 mx-auto mb-3" />
    <h3 class="font-bold text-zinc-300">No items match your filter</h3>
    <p class="text-sm text-zinc-500 mt-1">Try a different keyword or pick another category.</p>
    <button id="menu-reset" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-sm rounded-lg transition-colors">
      <X class="h-4 w-4" />
      Clear filters
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('menu-search-input');
    const clearBtn = document.getElementById('menu-clear-search');
    const resetBtn = document.getElementById('menu-reset');
    const grid = document.getElementById('menu-items-grid');
    const cards = grid ? Array.from(grid.querySelectorAll('.menu-item-card')) : [];
    const emptyState = document.getElementById('menu-empty-state');
    const pills = Array.from(document.querySelectorAll('.menu-cat-pill'));

    let query = '';
    let activeCategory = 'all';

    const cardData = cards.map((card) => ({
      el: card,
      name: (card.dataset.itemName || '').toLowerCase(),
      category: card.dataset.itemCategory || '',
    }));

    function apply() {
      let visible = 0;
      for (const c of cardData) {
        const matchesQuery = !query || c.name.includes(query);
        const matchesCat = activeCategory === 'all' || c.category === activeCategory;
        if (matchesQuery && matchesCat) {
          c.el.classList.remove('hidden');
          visible++;
        } else {
          c.el.classList.add('hidden');
        }
      }
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
      if (grid) grid.classList.toggle('hidden', visible === 0);
    }

    function setPillActive(target) {
      pills.forEach((p) => {
        const isActive = p === target;
        p.classList.toggle('active', isActive);
        p.classList.toggle('border-emerald-500/30', isActive);
        p.classList.toggle('bg-emerald-500/10', isActive);
        p.classList.toggle('text-emerald-400', isActive);
        p.classList.toggle('border-zinc-800', !isActive);
        p.classList.toggle('bg-zinc-900', !isActive);
        p.classList.toggle('text-zinc-400', !isActive);
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        query = e.target.value.toLowerCase().trim();
        if (clearBtn) clearBtn.classList.toggle('hidden', !query);
        apply();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        query = '';
        clearBtn.classList.add('hidden');
        apply();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        query = '';
        activeCategory = 'all';
        if (clearBtn) clearBtn.classList.add('hidden');
        const allPill = pills.find((p) => p.dataset.category === 'all');
        if (allPill) setPillActive(allPill);
        apply();
      });
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCategory = pill.dataset.category || 'all';
        setPillActive(pill);
        apply();
      });
    });

    // Wire up "Add to meal" buttons
    document.querySelectorAll('.add-to-meal-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const item = {
          id: el.dataset.id || el.dataset.name || Math.random().toString(36),
          name: el.dataset.name || 'Unknown item',
          source: el.dataset.source || 'Restaurant',
          calories: parseFloat(el.dataset.cal || '0'),
          protein: parseFloat(el.dataset.pro || '0'),
          carbs: parseFloat(el.dataset.carb || '0'),
          fat: parseFloat(el.dataset.fat || '0'),
        };
        if (window.nsAddToMeal) {
          window.nsAddToMeal(item);
          // Brief visual feedback
          const original = btn.innerHTML;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg><span>Added</span>';
          setTimeout(() => { btn.innerHTML = original; }, 1200);
        }
      });
    });
  })();
</script>
