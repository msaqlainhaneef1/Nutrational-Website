---
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import { Search, ArrowRight, Database, Filter, X } from '@lucide/astro';
import type { Restaurant } from '../schemas/restaurant';

interface Props {
  restaurants: Restaurant[];
  categories: { name: string; count: number }[];
}

const { restaurants, categories } = Astro.props;
const totalItems = restaurants.reduce((s, r) => s + (r.itemCount || r.categories.reduce((sc, c) => sc + c.items.length, 0)), 0);
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <Breadcrumb items={[{ label: 'Restaurants', url: '/restaurants' }]} />

  <!-- Header -->
  <div class="space-y-4">
    <div class="inline-flex items-center gap-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
      <Database class="h-4 w-4" />
      <span>{restaurants.length} chains and {totalItems.toLocaleString()} menu items</span>
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">
      Restaurant nutrition database
    </h1>
    <p class="text-zinc-400 text-base max-w-3xl leading-relaxed">
      Pick a chain to see every menu item with full calorie and macro data. Use the search to filter by name,
      or jump to a cuisine category. Every restaurant page includes an auto meal generator, meal builder,
      and a combined FDA nutrition label view.
    </p>
  </div>

  <!-- Search + Stats -->
  <div class="glass-card rounded-2xl p-5 space-y-4">
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-zinc-500">
        <Search class="h-5 w-5" />
      </div>
      <input
        type="text"
        id="restaurant-search-input"
        placeholder="Search restaurants by name, like Starbucks, McDonald's, or Chipotle..."
        class="block w-full pl-12 pr-12 py-3.5 bg-zinc-900 border border-zinc-800 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 text-sm transition-all"
      />
      <button id="clear-search" type="button" class="absolute inset-y-0 right-0 pr-4 hidden text-zinc-500 hover:text-white">
        <X class="h-5 w-5" />
      </button>
    </div>

    <!-- Category filter pills -->
    <div class="flex items-center gap-2 flex-wrap">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-zinc-500 mr-1">
        <Filter class="h-3.5 w-3.5" />
        <span>Filter:</span>
      </div>
      <button data-category="all" class="category-pill active px-3 py-1.5 rounded-full text-xs font-semibold border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 transition-all">
        All <span class="opacity-60">{restaurants.length}</span>
      </button>
      {categories.map((cat) => (
        <button
          data-category={cat.name}
          class="category-pill px-3 py-1.5 rounded-full text-xs font-semibold border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-zinc-200 hover:border-zinc-700 transition-all"
        >
          {cat.name} <span class="opacity-60">{cat.count}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Results meta -->
  <div class="flex items-center justify-between">
    <p class="text-sm text-zinc-500">
      Showing <span id="result-count" class="text-zinc-300 font-semibold">{restaurants.length}</span> restaurants
    </p>
  </div>

  <!-- Restaurant grid -->
  <div id="restaurant-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    {restaurants.map((res) => {
      const count = res.itemCount || res.categories.reduce((s, c) => s + c.items.length, 0);
      return (
        <a
          href={`/restaurants/${res.slug}`}
          data-name={res.name.toLowerCase()}
          data-category={res.category || 'Restaurant'}
          class="restaurant-card glass-card rounded-2xl p-5 flex flex-col group h-full"
        >
          <div class="flex items-start justify-between mb-3">
            <div class="text-4xl leading-none">{res.emoji || '🍽'}</div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-600 bg-zinc-900/80 border border-zinc-800 px-2 py-0.5 rounded-full">
              {res.category || 'Restaurant'}
            </span>
          </div>
          <div class="flex-grow">
            <h3 class="font-bold text-base text-white group-hover:text-emerald-400 transition-colors leading-snug">
              {res.name}
            </h3>
            <p class="text-xs text-zinc-500 mt-1.5 line-clamp-2 leading-relaxed">{res.tagline || res.description}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-zinc-900/80 flex items-center justify-between text-xs">
            <span class="text-zinc-400 font-semibold">{count} items</span>
            <span class="inline-flex items-center gap-1 text-emerald-400 font-bold">
              View
              <ArrowRight class="h-3.5 w-3.5 transform group-hover:translate-x-0.5 transition-transform" />
            </span>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Empty state -->
  <div id="empty-state" class="hidden glass-card rounded-3xl p-12 text-center">
    <div class="text-5xl mb-3">🔍</div>
    <h3 class="font-bold text-white text-lg">No restaurants match your search</h3>
    <p class="text-zinc-500 text-sm mt-1">Try a different keyword or clear the filter.</p>
    <button id="reset-search" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-sm rounded-lg transition-colors">
      <X class="h-4 w-4" />
      Reset search
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('restaurant-search-input');
    const clearBtn = document.getElementById('clear-search');
    const resetBtn = document.getElementById('reset-search');
    const grid = document.getElementById('restaurant-grid');
    const cards = grid ? Array.from(grid.querySelectorAll('.restaurant-card')) : [];
    const emptyState = document.getElementById('empty-state');
    const resultCount = document.getElementById('result-count');
    const pills = Array.from(document.querySelectorAll('.category-pill'));
    const total = cards.length;

    let query = '';
    let activeCategory = 'all';

    const cardData = cards.map((card) => ({
      el: card,
      name: (card.dataset.name || '').toLowerCase(),
      category: card.dataset.category || '',
    }));

    function apply() {
      let visible = 0;
      for (const c of cardData) {
        const matchesQuery = !query || c.name.includes(query);
        const matchesCat = activeCategory === 'all' || c.category === activeCategory;
        if (matchesQuery && matchesCat) {
          c.el.classList.remove('hidden');
          visible++;
        } else {
          c.el.classList.add('hidden');
        }
      }
      if (resultCount) resultCount.textContent = String(visible);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
      if (grid) grid.classList.toggle('hidden', visible === 0);
    }

    function setPillActive(target) {
      pills.forEach((p) => {
        const isActive = p === target;
        p.classList.toggle('active', isActive);
        p.classList.toggle('border-emerald-500/30', isActive);
        p.classList.toggle('bg-emerald-500/10', isActive);
        p.classList.toggle('text-emerald-400', isActive);
        p.classList.toggle('border-zinc-800', !isActive);
        p.classList.toggle('bg-zinc-900', !isActive);
        p.classList.toggle('text-zinc-400', !isActive);
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        query = e.target.value.toLowerCase().trim();
        if (clearBtn) clearBtn.classList.toggle('hidden', !query);
        apply();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        query = '';
        clearBtn.classList.add('hidden');
        apply();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        query = '';
        activeCategory = 'all';
        if (clearBtn) clearBtn.classList.add('hidden');
        const allPill = pills.find((p) => p.dataset.category === 'all');
        if (allPill) setPillActive(allPill);
        apply();
      });
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCategory = pill.dataset.category || 'all';
        setPillActive(pill);
        apply();
      });
    });

    // Support ?category= and ?q= deep links
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    const q = params.get('q');
    if (cat) {
      const target = pills.find((p) => p.dataset.category === cat);
      if (target) {
        activeCategory = cat;
        setPillActive(target);
      }
    }
    if (q && searchInput) {
      searchInput.value = q;
      query = q.toLowerCase().trim();
      if (clearBtn) clearBtn.classList.remove('hidden');
    }
    apply();
  })();
</script>
