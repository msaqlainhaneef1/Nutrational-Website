---
import Breadcrumb from '@/features/shared/components/Breadcrumb.astro';
import { ArrowRight, Utensils } from '@lucide/astro';

interface Props {
  restaurants: any[];
}

const { restaurants } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <Breadcrumb items={[{ label: 'Restaurants', url: '/restaurants' }]} />

  <div class="space-y-3">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Restaurant Nutrition Database</h1>
    <p class="text-zinc-400 text-sm max-w-2xl">
      Select a restaurant to browse their full menu, view exact calories, search individual dishes, and find healthy meals.
    </p>
  </div>

  <!-- Restaurants grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
    {restaurants.map((res) => (
      <a href={`/restaurants/${res.slug}`} class="glass-card rounded-3xl p-6 border border-zinc-800 flex items-center justify-between group">
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <div class="p-2 bg-emerald-500/10 text-emerald-400 rounded-xl border border-emerald-500/20">
              <Utensils class="h-5 w-5" />
            </div>
            <h2 class="font-extrabold text-xl text-white group-hover:text-emerald-400 transition-colors">{res.name}</h2>
          </div>
          <p class="text-zinc-400 text-sm leading-relaxed max-w-md">{res.description}</p>
        </div>
        
        <div class="p-3 bg-zinc-900 border border-zinc-800 rounded-2xl group-hover:border-emerald-500/30 group-hover:bg-emerald-500/5 transition-all text-zinc-400 group-hover:text-emerald-400">
          <ArrowRight class="h-5 w-5" />
        </div>
      </a>
    ))}
  </div>
</div>
