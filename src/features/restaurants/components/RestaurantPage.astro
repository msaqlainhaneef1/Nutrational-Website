---
import RestaurantMenu from './RestaurantMenu.astro';
import AuthorBox from '@/features/authors/components/AuthorBox.astro';
import { Info, Utensils, Clock } from '@lucide/astro';
import type { Restaurant } from '../schemas/restaurant';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;

const totalItems = restaurant.categories.reduce((s, c) => s + c.items.length, 0);
const allItems = restaurant.categories.flatMap((c) => c.items);
const avgCalories = totalItems > 0 ? Math.round(allItems.reduce((s, i) => s + i.calories, 0) / totalItems) : 0;
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-8">
    <RestaurantMenu restaurant={restaurant} />
  </div>

  <aside class="lg:col-span-4 space-y-5">
    <!-- Restaurant info card -->
    <div class="glass-card rounded-2xl p-5 space-y-4">
      <div class="flex items-center gap-3 pb-4 border-b border-zinc-900">
        <div class="text-4xl">{restaurant.emoji || '🍽'}</div>
        <div>
          <h3 class="font-bold text-white text-base">{restaurant.name}</h3>
          <p class="text-xs text-zinc-500 mt-0.5">{restaurant.category || 'Restaurant'}</p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 text-center">
        <div class="bg-zinc-900/60 rounded-xl p-3 border border-zinc-900">
          <div class="text-xs text-zinc-500 mb-1">Items</div>
          <div class="text-lg font-black text-white stat-number">{totalItems}</div>
        </div>
        <div class="bg-zinc-900/60 rounded-xl p-3 border border-zinc-900">
          <div class="text-xs text-zinc-500 mb-1">Avg calories</div>
          <div class="text-lg font-black text-emerald-400 stat-number">{avgCalories}</div>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="glass-card rounded-2xl p-5 border border-zinc-800/80 flex items-start gap-3">
      <div class="p-2 bg-blue-500/10 text-blue-400 rounded-xl border border-blue-500/20 flex-shrink-0">
        <Info class="h-5 w-5" />
      </div>
      <div class="space-y-1.5">
        <h4 class="font-bold text-sm text-zinc-200">Nutrition disclaimer</h4>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Values reflect standard recipes published by the chain. Actual portions may vary by location,
          preparation, and customization. Use as a guide, not a guarantee.
        </p>
      </div>
    </div>

    <!-- Verified expert -->
    <AuthorBox
      name="Dr. Sarah Jenkins"
      role="Clinical Dietitian and Nutritionist"
      bio="Helps patients navigate eating out and restaurant menus using evidence-based healthy dietary substitutions."
    />
  </aside>
</div>
