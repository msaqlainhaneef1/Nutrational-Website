                #fda-label { box-sizing: border-box; width: 100%; }
                #fda-label * { box-sizing: border-box; }
              </style>
            </head>
            <body>
              <div class="container">
                <h1>${restName} Summary</h1>
                <p>Nutritional calculations powered by NutriFlow</p>
                
                <div class="receipt">
                  <h3 class="receipt-title">Items Ordered</h3>
                  ${itemsSummaryHtml}
                </div>
                
                <!-- Inject FDA Label exactly -->
                ${labelHtml}
              </div>
              <script>
                window.onload = function() {
                  window.print();
                  setTimeout(function() { window.close(); }, 500);
                };
              <\/script>
            </body>
          </html>
        `);
        printWindow.document.close();
      }
    });
  }

  // Dietitian Suggest Swaps Logic
  function checkHealthySwaps() {
    // If no global menu structure exists, skip
    if (!(window as any).restaurantMenuData || Object.keys(meal).length === 0) {
      swapsBox.classList.add('hidden');
      currentSwapSuggestion = null;
      return;
    }

    const categories = (window as any).restaurantMenuData.categories;
    const addedItems = Object.keys(meal);
    
    // Scan items to find a swap suggestion candidate
    for (const baseItemName of addedItems) {
      const baseItem = meal[baseItemName];
      
      // Find the category block in menu data
      const catBlock = categories.find((c: any) => c.name === baseItem.category);
      if (!catBlock) continue;

      let bestAlternative: any = null;
      let maxCalSavings = 49; // Must save at least 50 calories

      catBlock.items.forEach((altItem: any) => {
        // Skip same item
        if (altItem.name === baseItemName) return;
        
        // Nutritional constraints: Alt calories must be less than base item by at least 50kcal,
        // and protein must not be significantly lower (no more than 5g drop)
        if (altItem.calories < baseItem.calories - 50 && altItem.protein >= baseItem.protein - 5) {
          const savings = baseItem.calories - altItem.calories;
          if (savings > maxCalSavings) {
            maxCalSavings = savings;
            bestAlternative = altItem;
          }
        }
      });

      // If we found a swap, display it and stop scanning
      if (bestAlternative) {
        currentSwapSuggestion = {
          baseItemName,
          swapItem: bestAlternative
        };

        const totalSaved = Math.round(maxCalSavings * baseItem.qty * baseItem.portion);
        swapTextEl.innerHTML = `Swap your <strong>${baseItemName}</strong> with a healthier alternative <strong>${bestAlternative.name}</strong> to save <strong>${totalSaved} calories</strong> and enjoy balanced macros!`;
        swapsBox.classList.remove('hidden');
        return;
      }
    }

    // If no item qualifies, hide suggestion box
    swapsBox.classList.add('hidden');
    currentSwapSuggestion = null;
  }

  // Apply Swap event handler
  if (applySwapBtn) {
    applySwapBtn.addEventListener('click', () => {
      if (!currentSwapSuggestion) return;

      const { baseItemName, swapItem } = currentSwapSuggestion;
      const baseItem = meal[baseItemName];
      if (!baseItem) return;

      // Copy quantitiy/portion configuration to alternative item
      meal[swapItem.name] = {
        qty: baseItem.qty,
        portion: baseItem.portion,
        calories: swapItem.calories,
        protein: swapItem.protein,
        carbs: swapItem.carbs,
        fat: swapItem.fat,
        sodium: swapItem.sodium,
        fiber: swapItem.fiber,
        serving: swapItem.servingSize || '',
        category: baseItem.category
      };

      // Delete base item
      delete meal[baseItemName];

      // Update Menu Cards UI (counters and borders)
      const baseCard = document.querySelector(`.menu-item-card[data-item-name-raw="${baseItemName}"]`);
      if (baseCard) {
        baseCard.classList.remove('border-emerald-500/30', 'bg-emerald-500/[0.015]');
        const counter = baseCard.querySelector('.item-qty-display');
        if (counter) counter.textContent = '0';
      }

      const swapCard = document.querySelector(`.menu-item-card[data-item-name-raw="${swapItem.name}"]`);
      if (swapCard) {
        swapCard.classList.add('border-emerald-500/30', 'bg-emerald-500/[0.015]');
        const counter = swapCard.querySelector('.item-qty-display');
        if (counter) counter.textContent = baseItem.qty.toString();
      }

      // Re-trigger calculator update
      updateCalculatorUI();
    });
  }

  function updateCalculatorUI() {
    const slug = calcPanel.dataset.restaurantSlug;
    if (slug) {
      localStorage.setItem(`meal_calc_${slug}`, JSON.stringify(meal));
    }

    const mealKeys = Object.keys(meal);
    
    if (mealKeys.length === 0) {
      calcEmpty.classList.remove('hidden');
      calcActive.classList.add('hidden');
      clearBtn.classList.add('hidden');
      calcPanel.classList.remove('border-emerald-500/30');
      calcPanel.classList.add('border-emerald-500/20');
      
      // Hide mobile bottom bar
      if (mobileDrawer) mobileDrawer.classList.add('translate-y-full');
      
      // Hide suggestions
      swapsBox.classList.add('hidden');
      currentSwapSuggestion = null;
      return;
    }

    calcEmpty.classList.add('hidden');
    calcActive.classList.remove('hidden');
    clearBtn.classList.remove('hidden');
    calcPanel.classList.remove('border-emerald-500/20');
    calcPanel.classList.add('border-emerald-500/30');

    // Show mobile bottom bar
    if (mobileDrawer) mobileDrawer.classList.remove('translate-y-full');

    // Render list
    itemsList.innerHTML = '';
    
    let totalCals = 0;
    let totalProt = 0;
    let totalCarbs = 0;
    let totalFat = 0;
    let totalSod = 0;
    let totalFib = 0;
    let totalItemsCount = 0;

    mealKeys.forEach((key) => {
      const item = meal[key];
      const scale = item.qty * item.portion;
      
      totalCals += item.calories * scale;
      totalProt += item.protein * scale;
      totalCarbs += item.carbs * scale;
      totalFat += item.fat * scale;
      totalSod += item.sodium * scale;
      totalFib += item.fiber * scale;
      totalItemsCount += item.qty;

      // Add row containing custom Portion size selector dropdown
      const row = document.createElement('div');
      row.className = 'flex flex-col gap-1.5 bg-zinc-950/40 p-2.5 rounded-xl border border-zinc-900/50';
      row.innerHTML = `
        <div class="flex justify-between items-start">
          <div class="space-y-0.5 max-w-[70%]">
            <h5 class="text-xs font-bold text-white truncate">${key}</h5>
            <p class="text-[10px] text-zinc-500">${item.serving ? item.serving + ' • ' : ''}${Math.round(item.calories * scale)} cal</p>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-[10px] font-black text-zinc-400 bg-zinc-900 px-2 py-1 rounded border border-zinc-800">x${item.qty}</span>
            <button 
              type="button" 
              class="text-zinc-650 hover:text-red-400 p-0.5 rounded transition-colors remove-calc-row" 
              data-item-name-raw="${key}"
              aria-label="Remove item"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
              </svg>
            </button>
          </div>
        </div>
        <div class="flex justify-between items-center pt-1.5 border-t border-zinc-900/40">
          <span class="text-[9px] uppercase tracking-wider text-zinc-500 font-bold">Portion Size</span>
          <select 
            class="item-portion-select bg-zinc-950 border border-zinc-800/60 rounded px-1.5 py-0.5 text-[9px] font-bold text-zinc-400 focus:outline-none focus:border-emerald-500/50"
            data-item-name-raw="${key}"
          >
            <option value="0.5" ${item.portion === 0.5 ? 'selected' : ''}>0.5x (Half)</option>
            <option value="1.0" ${item.portion === 1.0 ? 'selected' : ''}>1.0x (Normal)</option>
            <option value="1.5" ${item.portion === 1.5 ? 'selected' : ''}>1.5x (Large)</option>
            <option value="2.0" ${item.portion === 2.0 ? 'selected' : ''}>2.0x (Double)</option>
          </select>
        </div>
      `;
      itemsList.appendChild(row);
    });

    // Update main text displays
    totalCaloriesEl.textContent = `${Math.round(totalCals)} cal`;

    // Mobile drawer text
    if (mobileTotalCalsEl) mobileTotalCalsEl.textContent = `${Math.round(totalCals)} cal`;

    // FDA Label updates
    if (fdaServings) fdaServings.textContent = totalItemsCount.toString();
    if (fdaCalories) fdaCalories.textContent = Math.round(totalCals).toString();
    
    if (fdaFat) fdaFat.textContent = `${Math.round(totalFat * 10) / 10}g`;
    if (fdaFatDv) fdaFatDv.textContent = `${Math.round((totalFat / 78) * 100)}%`;
    
    if (fdaSodium) fdaSodium.textContent = `${Math.round(totalSod)}mg`;
    if (fdaSodiumDv) fdaSodiumDv.textContent = `${Math.round((totalSod / 2300) * 100)}%`;
    
    if (fdaCarbs) fdaCarbs.textContent = `${Math.round(totalCarbs * 10) / 10}g`;
    if (fdaCarbsDv) fdaCarbsDv.textContent = `${Math.round((totalCarbs / 275) * 100)}%`;
    
    if (fdaFiber) fdaFiber.textContent = `${Math.round(totalFib * 10) / 10}g`;
    if (fdaFiberDv) fdaFiberDv.textContent = `${Math.round((totalFib / 28) * 100)}%`;
    
    if (fdaProtein) fdaProtein.textContent = `${Math.round(totalProt * 10) / 10}g`;

    // Update Donut Chart
    const proteinCals = totalProt * 4;
    const carbsCals = totalCarbs * 4;
    const fatCals = totalFat * 9;
    updateChart(proteinCals, carbsCals, fatCals);

    // Progress bar calculations
    const percent = Math.min(Math.round((totalCals / targetCalories) * 100), 500);
    progressPercentEl.textContent = `${percent}%`;
    progressBar.style.width = `${Math.min(percent, 100)}%`;

    // Color code progress bar
    progressBar.className = 'h-full rounded-full transition-all duration-300 bg-gradient-to-r ';
    if (percent <= 50) {
      progressBar.className += 'from-emerald-500 to-teal-500';
    } else if (percent <= 100) {
      progressBar.className += 'from-amber-500 to-orange-500';
    } else {
      progressBar.className += 'from-red-500 to-rose-600';
    }

    // Attach row delete triggers
    document.querySelectorAll('.remove-calc-row').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.itemNameRaw!;
        if (meal[key]) {
          delete meal[key];
          
          // Reset card UI
          const card = document.querySelector(`.menu-item-card[data-item-name-raw="${key}"]`);
          if (card) {
            card.classList.remove('border-emerald-500/30', 'bg-emerald-500/[0.015]');
          }
          const display = document.querySelector(`.item-qty-display[data-item-name-raw="${key}"]`);
          if (display) {
            display.textContent = '0';
          }

          updateCalculatorUI();
        }
      });
    });

    // Attach Portion dropdown events
    document.querySelectorAll('.item-portion-select').forEach((select) => {
      select.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const key = target.dataset.itemNameRaw!;
        const val = parseFloat(target.value);
        if (meal[key]) {
          meal[key].portion = val;
          updateCalculatorUI();
        }
      });
    });

    // Scan dietitian swaps
    checkHealthySwaps();
  }

  // Setup Event Delegation for grid increment/decrement
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const decBtn = target.closest('.btn-decrement') as HTMLButtonElement | null;
    const incBtn = target.closest('.btn-increment') as HTMLButtonElement | null;
    
    if (decBtn) {
      const rawName = decBtn.dataset.itemNameRaw!;
      const card = decBtn.closest('.menu-item-card') as HTMLElement;
      const qtyDisplay = card.querySelector('.item-qty-display')!;
      
      if (meal[rawName]) {
        meal[rawName].qty--;
        if (meal[rawName].qty <= 0) {
          delete meal[rawName];
          card.classList.remove('border-emerald-500/30', 'bg-emerald-500/[0.015]');
          qtyDisplay.textContent = '0';
        } else {
          qtyDisplay.textContent = meal[rawName].qty.toString();
        }
        updateCalculatorUI();
      }
    }
    
    if (incBtn) {
      const rawName = incBtn.dataset.itemNameRaw!;
      const card = incBtn.closest('.menu-item-card') as HTMLElement;
      const qtyDisplay = card.querySelector('.item-qty-display')!;
      
      if (!meal[rawName]) {
        meal[rawName] = {
          qty: 1,
          portion: 1.0,
          calories: parseFloat(card.dataset.itemCalories || '0'),
          protein: parseFloat(card.dataset.itemProtein || '0'),
          carbs: parseFloat(card.dataset.itemCarbs || '0'),
          fat: parseFloat(card.dataset.itemFat || '0'),
          sodium: parseFloat(card.dataset.itemSodium || '0'),
          fiber: parseFloat(card.dataset.itemFiber || '0'),
          serving: card.dataset.itemServing || '',
          category: card.dataset.itemCategory || ''
        };
        card.classList.add('border-emerald-500/30', 'bg-emerald-500/[0.015]');
      } else {
        meal[rawName].qty++;
      }
      qtyDisplay.textContent = meal[rawName].qty.toString();
      updateCalculatorUI();
    }
  });

  // Toggle Macro Chart Accordion
  const toggleMacroBtn = document.getElementById('toggle-macro-chart');
  const macroContainer = document.getElementById('macro-chart-container');
  const chevronMacro = document.getElementById('chevron-macro');

  if (toggleMacroBtn && macroContainer && chevronMacro) {
    toggleMacroBtn.addEventListener('click', () => {
      const isHidden = macroContainer.classList.contains('hidden');
      if (isHidden) {
        macroContainer.classList.remove('hidden');
        macroContainer.classList.add('flex');
        chevronMacro.classList.add('rotate-180');
      } else {
        macroContainer.classList.add('hidden');
        macroContainer.classList.remove('flex');
        chevronMacro.classList.remove('rotate-180');
      }
    });
  }

  // Toggle FDA Label Accordion
  const toggleFdaBtn = document.getElementById('toggle-fda-label');
  const fdaContainer = document.getElementById('fda-label-container');
  const chevronFda = document.getElementById('chevron-fda');

  if (toggleFdaBtn && fdaContainer && chevronFda) {
    toggleFdaBtn.addEventListener('click', () => {
      const isHidden = fdaContainer.classList.contains('hidden');
      if (isHidden) {
        fdaContainer.classList.remove('hidden');
        chevronFda.classList.add('rotate-180');
      } else {
        fdaContainer.classList.add('hidden');
        chevronFda.classList.remove('rotate-180');
      }
    });
  }

  function loadMealFromLocalStorage() {
    const slug = calcPanel.dataset.restaurantSlug;
    if (!slug) return;
    const stored = localStorage.getItem(`meal_calc_${slug}`);
    if (stored) {
      try {
        const storedMeal = JSON.parse(stored);
        if (Object.keys(storedMeal).length > 0) {
          meal = storedMeal;
          
          // Restore card styling & display values
          Object.keys(meal).forEach((key) => {
            const item = meal[key];
            const card = document.querySelector(`.menu-item-card[data-item-name-raw="${key}"]`);
            if (card) {
              card.classList.add('border-emerald-500/30', 'bg-emerald-500/[0.015]');
              const display = card.querySelector('.item-qty-display');
              if (display) display.textContent = item.qty.toString();
            }
          });
          
          updateCalculatorUI();
        }
      } catch (err) {
        console.error('Error loading stored meal calculator data', err);
      }
    }
  }

  // On DOM Load (robust initialization)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initChart();
      loadMealFromLocalStorage();
    });
  } else {
    initChart();
    loadMealFromLocalStorage();
  }
</script>
